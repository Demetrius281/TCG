{
  "_doc": "Single source of rule values for scripts/audit.mjs. Must agree with CLAUDE.md and src/styles/tokens.css (checked on every audit run). Widths below 'fluid.from' use the mobile value, above 'fluid.to' the desktop value; fluid values are linear in between (the design uses clamp()).",
  "tolerance": {
    "px": 1,
    "font": 0.1,
    "gap": 1.5,
    "stuck": 4,
    "illustrationTop": 2,
    "ratio": 0.02,
    "screenGapExtra": 3
  },
  "widths": {
    "full": [
      375,
      768,
      1280,
      1440
    ],
    "sweep": {
      "from": 320,
      "to": 1600,
      "step": 40
    }
  },
  "fluid": {
    "from": 375,
    "to": 1280
  },
  "breakpoints": {
    "tablet": 768,
    "desktop": 1024
  },
  "container": {
    "max": 1200,
    "gutter": {
      "mode": "fluid",
      "mobile": 20,
      "desktop": 40
    }
  },
  "header": {
    "mode": "step",
    "stepAt": 1024,
    "mobile": 56,
    "desktop": 76
  },
  "pageTop": {
    "mode": "step",
    "stepAt": 1024,
    "mobile": 48,
    "desktop": 80
  },
  "roles": {
    "page-title": {
      "mobile": 32,
      "desktop": 48,
      "family": "sans",
      "weight": 500,
      "case": "none",
      "tag": "H1"
    },
    "section-title": {
      "mobile": 28,
      "desktop": 40,
      "family": "sans",
      "weight": 500,
      "case": "none",
      "tag": "H2"
    },
    "card-title": {
      "mobile": 20,
      "desktop": 24,
      "family": "sans",
      "weight": 500,
      "case": "none",
      "tag": "H3"
    },
    "text": {
      "mobile": 16,
      "desktop": 17,
      "family": "sans",
      "weight": 400,
      "case": "none"
    },
    "small": {
      "mobile": 14,
      "desktop": 15,
      "family": "sans",
      "weight": 400,
      "case": "none"
    },
    "label": {
      "mobile": 12,
      "desktop": 12,
      "family": "mono",
      "weight": 500,
      "case": "uppercase"
    },
    "metric": {
      "mobile": 48,
      "desktop": 72,
      "family": "sans",
      "weight": 300,
      "case": "none"
    },
    "control": {
      "mobile": 14,
      "desktop": 15,
      "family": "sans",
      "weight": 500,
      "case": "none",
      "appliesTo": [
        ".btn",
        ".ei-btn",
        "a"
      ]
    }
  },
  "spacing": {
    "headingText": 16,
    "cardTitleText": 12,
    "paragraph": 16,
    "textButtons": 32,
    "buttons": {
      "mode": "step",
      "stepAt": 768,
      "mobile": 12,
      "desktop": 16
    },
    "headContent": 40,
    "cards": {
      "mode": "fluid",
      "mobile": 16,
      "desktop": 32
    },
    "cardPadding": 24,
    "listItems": 8
  },
  "screen": {
    "padding": {
      "mode": "fluid",
      "mobile": 56,
      "desktop": 112
    },
    "tones": [
      "default",
      "sunken",
      "inverse"
    ]
  },
  "width": {
    "text": 720,
    "pageTitle": 900
  },
  "cards": {
    "tabletColumns": 2,
    "mobileColumns": 1,
    "desktopColumns": [
      2,
      3,
      4
    ]
  },
  "button": {
    "height": 52,
    "radius": 0,
    "fullWidthBelow": 768,
    "primaryClasses": [
      "btn-primary",
      "btn-inverse",
      "ei-btn"
    ]
  },
  "list": {
    "marker": 8,
    "gapToText": 12,
    "itemGap": 8,
    "numberedRole": "label"
  },
  "firstScreen": {
    "maxButtons": 2,
    "paragraphs": 1,
    "illustrationShownFrom": 768,
    "illustrationSplitFrom": 1024,
    "illustrationRatio": 0.898,
    "illustrationGap": 64,
    "A2": {
      "page": "/platform",
      "maxItems": 2,
      "textToList": 32,
      "listToButtons": 32
    }
  },
  "exclusions": {
    "selector": "svg, [data-illustration]",
    "note": "Content inside illustration SVGs and illustration hosts (loaded fragments) is excluded from every check.",
    "r1GlyphPattern": "^[\\s→←↑↓↗+−×·•]+$",
    "r1Note": "R1 only: aria-hidden elements that contain nothing but a glyph (arrow, plus sign) are not treated as text that starts a line. They are still checked by R3."
  },
  "sync": {
    "claudeMd": [
      {
        "path": "container.max",
        "pattern": "Container max (\\d+)px"
      },
      {
        "path": "container.gutter.mobile",
        "pattern": "Side gutter (\\d+)px mobile"
      },
      {
        "path": "container.gutter.desktop",
        "pattern": "Side gutter \\d+px mobile / (\\d+)px desktop"
      },
      {
        "path": "header.mobile",
        "pattern": "Header (\\d+)px mobile"
      },
      {
        "path": "header.desktop",
        "pattern": "Header \\d+px mobile / (\\d+)px desktop"
      },
      {
        "path": "pageTop.mobile",
        "pattern": "page-title top: (\\d+)px mobile"
      },
      {
        "path": "pageTop.desktop",
        "pattern": "page-title top: \\d+px mobile / (\\d+)px desktop"
      },
      {
        "path": "spacing.headingText",
        "pattern": "page-title -> text (\\d+)px"
      },
      {
        "path": "spacing.textButtons",
        "pattern": "text -> buttons (\\d+)px"
      },
      {
        "path": "spacing.buttons.mobile",
        "pattern": "between buttons (\\d+)/\\d+px"
      },
      {
        "path": "spacing.buttons.desktop",
        "pattern": "between buttons \\d+/(\\d+)px"
      },
      {
        "path": "width.pageTitle",
        "pattern": "page-title max width (\\d+)px"
      },
      {
        "path": "width.text",
        "pattern": "text max width (\\d+)px"
      },
      {
        "path": "roles.page-title.mobile",
        "pattern": "page-title (\\d+)/\\d+ \\(h1"
      },
      {
        "path": "roles.page-title.desktop",
        "pattern": "page-title \\d+/(\\d+) \\(h1"
      },
      {
        "path": "roles.section-title.mobile",
        "pattern": "section-title (\\d+)/\\d+ \\(h2"
      },
      {
        "path": "roles.section-title.desktop",
        "pattern": "section-title \\d+/(\\d+) \\(h2"
      },
      {
        "path": "roles.card-title.mobile",
        "pattern": "card-title (\\d+)/\\d+ \\(h3"
      },
      {
        "path": "roles.card-title.desktop",
        "pattern": "card-title \\d+/(\\d+) \\(h3"
      },
      {
        "path": "roles.text.mobile",
        "pattern": "\\btext (\\d+)/\\d+ \\(all running"
      },
      {
        "path": "roles.text.desktop",
        "pattern": "\\btext \\d+/(\\d+) \\(all running"
      },
      {
        "path": "roles.small.mobile",
        "pattern": "small (\\d+)/\\d+ \\(notes"
      },
      {
        "path": "roles.small.desktop",
        "pattern": "small \\d+/(\\d+) \\(notes"
      },
      {
        "path": "roles.label.mobile",
        "pattern": "label (\\d+) mono uppercase"
      },
      {
        "path": "roles.metric.mobile",
        "pattern": "metric (\\d+)/\\d+ \\(big"
      },
      {
        "path": "roles.metric.desktop",
        "pattern": "metric \\d+/(\\d+) \\(big"
      },
      {
        "path": "spacing.headContent",
        "pattern": "heading block -> screen content (\\d+)"
      },
      {
        "path": "spacing.cardTitleText",
        "pattern": "card title -> card text (\\d+)"
      },
      {
        "path": "spacing.cards.mobile",
        "pattern": "between cards (\\d+) mobile"
      },
      {
        "path": "spacing.cards.desktop",
        "pattern": "between cards \\d+ mobile / (\\d+) desktop"
      },
      {
        "path": "spacing.cardPadding",
        "pattern": "card padding (\\d+)"
      },
      {
        "path": "spacing.listItems",
        "pattern": "list items (\\d+)"
      },
      {
        "path": "screen.padding.mobile",
        "pattern": "Padding top and bottom (\\d+)px mobile"
      },
      {
        "path": "screen.padding.desktop",
        "pattern": "Padding top and bottom \\d+px mobile / (\\d+)px desktop"
      },
      {
        "path": "button.height",
        "pattern": "Height (\\d+)px; full width"
      },
      {
        "path": "list.marker",
        "pattern": "green diamond (\\d+)px"
      },
      {
        "path": "list.gapToText",
        "pattern": "(\\d+)px to text"
      },
      {
        "path": "firstScreen.A2.maxItems",
        "pattern": "list of up to (\\d+) items"
      },
      {
        "path": "firstScreen.A2.textToList",
        "pattern": "Text -> list (\\d+)px"
      },
      {
        "path": "firstScreen.A2.listToButtons",
        "pattern": "list -> buttons (\\d+)px"
      },
      {
        "path": "roles.control.mobile",
        "pattern": "control (\\d+)/\\d+ \\(button"
      },
      {
        "path": "roles.control.desktop",
        "pattern": "control \\d+/(\\d+) \\(button"
      },
      {
        "path": "scale.steps.0",
        "pattern": "every gap is one of (\\d+), \\d+, \\d+, \\d+, \\d+, \\d+;"
      },
      {
        "path": "scale.steps.1",
        "pattern": "every gap is one of \\d+, (\\d+), \\d+, \\d+, \\d+, \\d+;"
      },
      {
        "path": "scale.steps.2",
        "pattern": "every gap is one of \\d+, \\d+, (\\d+), \\d+, \\d+, \\d+;"
      },
      {
        "path": "scale.steps.3",
        "pattern": "every gap is one of \\d+, \\d+, \\d+, (\\d+), \\d+, \\d+;"
      },
      {
        "path": "scale.steps.4",
        "pattern": "every gap is one of \\d+, \\d+, \\d+, \\d+, (\\d+), \\d+;"
      },
      {
        "path": "scale.steps.5",
        "pattern": "every gap is one of \\d+, \\d+, \\d+, \\d+, \\d+, (\\d+);"
      },
      {
        "path": "fixed.splitGap",
        "pattern": "split gap (\\d+)"
      },
      {
        "path": "fixed.articleNav",
        "pattern": "article nav (\\d+)"
      }
    ],
    "tokens": [
      {
        "token": "--fs-page-title",
        "path": "roles.page-title"
      },
      {
        "token": "--fs-section-title",
        "path": "roles.section-title"
      },
      {
        "token": "--fs-card-title",
        "path": "roles.card-title"
      },
      {
        "token": "--fs-text",
        "path": "roles.text"
      },
      {
        "token": "--fs-small",
        "path": "roles.small"
      },
      {
        "token": "--fs-metric",
        "path": "roles.metric"
      },
      {
        "token": "--gutter",
        "path": "container.gutter"
      },
      {
        "token": "--section-y",
        "path": "screen.padding"
      },
      {
        "token": "--grid-gap",
        "path": "spacing.cards"
      }
    ],
    "tokenPx": [
      {
        "token": "--container",
        "path": "container.max"
      },
      {
        "token": "--container-prose",
        "path": "width.text"
      },
      {
        "token": "--hero-title-max",
        "path": "width.pageTitle"
      },
      {
        "token": "--control-h",
        "path": "button.height"
      },
      {
        "token": "--header-h",
        "path": "header.mobile"
      },
      {
        "token": "--header-h-lg",
        "path": "header.desktop"
      },
      {
        "token": "--page-top",
        "path": "pageTop.mobile"
      },
      {
        "token": "--fs-label",
        "path": "roles.label.mobile"
      },
      {
        "token": "--s-8",
        "path": "scale.steps.0"
      },
      {
        "token": "--s-12",
        "path": "scale.steps.1"
      },
      {
        "token": "--s-16",
        "path": "scale.steps.2"
      },
      {
        "token": "--s-24",
        "path": "scale.steps.3"
      },
      {
        "token": "--s-32",
        "path": "scale.steps.4"
      },
      {
        "token": "--s-40",
        "path": "scale.steps.5"
      },
      {
        "token": "--split-gap",
        "path": "fixed.splitGap"
      },
      {
        "token": "--article-nav",
        "path": "fixed.articleNav"
      }
    ]
  },
  "scale": {
    "_doc": "D5: every gap/padding is one of these px values (token --s-<px>). Sections use --section-y 56/112 fluid, card grids --grid-gap 16/32 fluid. Nothing else exists.",
    "steps": [
      8,
      12,
      16,
      24,
      32,
      40
    ],
    "fluid": {
      "section": {
        "mobile": 56,
        "desktop": 112
      },
      "grid": {
        "mobile": 16,
        "desktop": 32
      }
    }
  },
  "fixed": {
    "_doc": "Named fixed values (tokens in tokens.css). These are the only non-scale lengths.",
    "header": {
      "mobile": 56,
      "desktop": 76
    },
    "pageTop": {
      "mobile": 48,
      "desktop": 80
    },
    "splitGap": 64,
    "articleNav": 280,
    "container": 1200,
    "text": 720,
    "pageTitle": 900,
    "control": 52,
    "borders": [
      1,
      2,
      3
    ]
  },
  "decisions": {
    "D1": "Button and link text: role control = small size 14/15, sans, weight 500, no uppercase; only .btn, .ei-btn, <a>.",
    "D2": "No bold inside text: no <b>/<strong>, no weight 600/700 anywhere.",
    "D3": "Text max width 720 for all running text (p, li, dd, blockquote, card text, list text, article). Table cells exempt.",
    "D4": "Text -> buttons 32 everywhere, including cards and forms.",
    "D5": "Spacing scale 8,12,16,24,32,40; section 56/112 fluid; card grid 16/32 fluid; named fixed values only.",
    "D6": "card-title (h3/h4) -> following text 12 everywhere; heading (h1/h2) -> text 16.",
    "D7": "Exclusions: svg/[data-illustration]; aria-hidden glyph-only elements for R1."
  },
  "lock": {
    "_doc": "scripts/lock.mjs reads this block.",
    "allowedCssFiles": [
      "src/styles/tokens.css",
      "src/styles/base.css",
      "src/components/ui/*.astro"
    ],
    "blockAllowedProps": [
      "display",
      "grid-area",
      "grid-template-areas",
      "align-*",
      "justify-*",
      "place-*",
      "order",
      "flex-direction",
      "flex-wrap",
      "visibility",
      "overflow",
      "overflow-x",
      "overflow-y",
      "color",
      "background",
      "background-color",
      "border",
      "border-top",
      "border-bottom",
      "border-left",
      "border-right",
      "border-color",
      "border-block",
      "border-inline",
      "border-block-start",
      "border-block-end",
      "border-inline-start",
      "border-inline-end",
      "text-align"
    ],
    "blockForbiddenPatterns": [
      "margin*",
      "padding*",
      "gap",
      "row-gap",
      "column-gap",
      "font*",
      "line-height",
      "letter-spacing",
      "text-transform",
      "width",
      "min-width",
      "max-width",
      "inline-size",
      "min-inline-size",
      "max-inline-size",
      "height",
      "min-height",
      "max-height",
      "block-size",
      "top",
      "right",
      "bottom",
      "left",
      "inset*",
      "grid-template-columns",
      "grid-template-rows",
      "flex-basis",
      "border-radius",
      "transform"
    ],
    "classesOwnedByPrimitives": [
      "t-*",
      "btn",
      "btn-*",
      "ei-btn",
      "list",
      "grid",
      "card",
      "stack",
      "head",
      "cluster"
    ],
    "scaleProps": [
      "gap"
    ],
    "blockValueRules": {
      "color": "var(--c-*)",
      "background": "var(--c-*)",
      "background-color": "var(--c-*)",
      "border*": "var(--c-*)/var(--bw-*)"
    },
    "primitiveAllowedValue": "var(--*) | 0 | auto | none | inherit | currentColor | transparent | 50% | 100% | 1fr | minmax(...) with tokens | keywords",
    "spacingTokens": [
      "--s-8",
      "--s-12",
      "--s-16",
      "--s-24",
      "--s-32",
      "--s-40",
      "--section-y",
      "--grid-gap",
      "--gutter",
      "--split-gap",
      "--page-top",
      "--header-h",
      "--header-h-lg",
      "--control-h",
      "--bw-1",
      "--bw-2",
      "--bw-3",
      "--size-mark",
      "--size-icon",
      "--size-icon-lg",
      "--size-avatar",
      "--size-media",
      "--size-cell"
    ]
  }
}
