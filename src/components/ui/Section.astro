---
// The only way to write a section (CLAUDE.md rules 1 and 5, variation B).
//   stacked (default): head and content in one column, gap 40.
//   split: slot "head" 5/12 left, content 7/12 right from 1024px, gap --split-gap.
//   article: slot "nav" (--article-nav) left, text column (--container-prose) right from 1024px.
//   hero: the first screen. Copy left; with `art`, slot "art" right, 50/50, gap --split-gap, top-aligned.
interface Props {
  tone?: 'default' | 'sunken' | 'inverse';
  id?: string;
  labelledby?: string;
  nav?: string;
  layout?: 'stacked' | 'split' | 'article' | 'hero';
  /** hero only: reserve the illustration column. */
  art?: string;
  /** split only: the head column stays in view while the content scrolls. */
  sticky?: boolean;
}
const { tone = 'default', id, labelledby, nav, layout = 'stacked', art, sticky = false } = Astro.props;
const twoCol = layout === 'split' || layout === 'article';
---
<section class:list={['section', `tone-${tone}`, tone === 'inverse' && 'on-inverse']} id={id} data-nav={nav} aria-labelledby={labelledby}>
  {
    layout === 'hero' ? (
      <div class:list={['inner', 'hero', art && 'has-art']} data-art={art}>
        <div class="copy"><slot /></div>
        {art && <div class="art"><slot name="art" /></div>}
      </div>
    ) : twoCol ? (
      <div class={`inner layout-${layout}`}>
        <div class:list={['side', sticky && 'is-sticky']}>{layout === 'split' ? <slot name="head" /> : <slot name="nav" />}</div>
        <div class="body"><slot /></div>
      </div>
    ) : (
      <div class="inner stacked"><slot /></div>
    )
  }
</section>

<style>
  .section {
    /* Semantic colour roles. Blocks read these, so one block works on every tone. */
    --c-bg: var(--color-bg);
    --c-surface: var(--color-surface);
    --c-text: var(--color-text);
    --c-text-2: var(--color-text-2);
    --c-text-3: var(--color-text-3);
    --c-border: var(--color-border);
    --c-border-strong: var(--color-border-strong);
    --c-accent: var(--color-accent);
    padding-block: var(--section-y);
    background: var(--c-bg);
    color: var(--c-text);
  }
  .tone-sunken { --c-bg: var(--color-sunken); }
  .tone-inverse {
    --c-bg: var(--color-inverse);
    --c-surface: var(--color-inverse-raised);
    --c-text: var(--color-on-inverse);
    --c-text-2: var(--color-on-inverse-2);
    --c-text-3: var(--color-on-inverse-2);
    --c-border: var(--color-border-inverse);
    --c-border-strong: var(--color-border-inverse);
    --c-accent: var(--color-accent-inverse);
  }
  .inner {
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
  }
  .stacked, .hero, .layout-split, .layout-article { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-40); }
  .stacked > * { min-width: 0; }
  .side, .body, .copy, .art { min-width: 0; }
  .copy { display: flex; flex-direction: column; align-items: flex-start; max-width: var(--hero-title-max); }
  .art { display: none; }
  @media (min-width: 768px) {
    .art { display: block; }
  }
  @media (min-width: 1024px) {
    .layout-split { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--split-gap); }
    .layout-article { grid-template-columns: var(--article-nav) minmax(0, var(--container-prose)); gap: var(--split-gap); }
    .has-art { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: var(--split-gap); }
    .is-sticky { position: sticky; top: calc(var(--header-h-lg) + var(--s-24)); align-self: start; }
  }
</style>
