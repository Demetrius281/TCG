---
// The only way to write a section (CLAUDE.md rules 1 and 5, variation B).
//   stacked (default): head and content in one column.
//   split: slot "head" 5/12 left, content 7/12 right from 1024px, gap --split-gap.
//   article: slot "nav" (--article-nav) left, text column (--container-prose) right from 1024px.
interface Props {
  tone?: 'default' | 'sunken' | 'inverse';
  id?: string;
  labelledby?: string;
  nav?: string;
  layout?: 'stacked' | 'split' | 'article';
}
const { tone = 'default', id, labelledby, nav, layout = 'stacked' } = Astro.props;
const twoCol = layout !== 'stacked';
---
<section class:list={['section', `tone-${tone}`, tone === 'inverse' && 'on-inverse']} id={id} data-nav={nav} aria-labelledby={labelledby}>
  <div class:list={['inner', twoCol && `layout-${layout}`]}>
    {
      twoCol ? (
        <>
          <div class="side">{layout === 'split' ? <slot name="head" /> : <slot name="nav" />}</div>
          <div class="body"><slot /></div>
        </>
      ) : (
        <slot />
      )
    }
  </div>
</section>

<style>
  .section {
    /* Semantic colour roles. Blocks read these, so one block works on every tone. */
    --c-bg: var(--color-bg);
    --c-surface: var(--color-surface);
    --c-text: var(--color-text);
    --c-text-2: var(--color-text-2);
    --c-text-3: var(--color-text-3);
    --c-border: var(--color-border);
    --c-border-strong: var(--color-border-strong);
    --c-accent: var(--color-accent);
    padding-block: var(--section-y);
    background: var(--c-bg);
    color: var(--c-text);
  }
  .tone-sunken { --c-bg: var(--color-sunken); }
  .tone-inverse {
    --c-bg: var(--color-inverse);
    --c-surface: var(--color-inverse-raised);
    --c-text: var(--color-on-inverse);
    --c-text-2: var(--color-on-inverse-2);
    --c-text-3: var(--color-on-inverse-2);
    --c-border: var(--color-border-inverse);
    --c-border-strong: var(--color-border-inverse);
    --c-accent: var(--color-accent-inverse);
  }
  /* Page top: the first section starts --page-top below the header (rule 2). */
  :global(main > section.section:first-of-type) { padding-top: var(--page-top); }
  .inner {
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
  }
  .side, .body { min-width: 0; }
  .layout-split, .layout-article { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-10); }
  @media (min-width: 1024px) {
    .layout-split { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--split-gap); }
    .layout-article { grid-template-columns: var(--article-nav) minmax(0, var(--container-prose)); gap: var(--split-gap); }
  }
</style>
