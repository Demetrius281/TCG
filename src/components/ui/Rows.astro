---
// Repeated rows with hairlines. One width for rows and dividers: the container (or the column it sits in).
//   A row with href is one link; `go` is the action, right-aligned to the row's right edge.
//   bleed: dividers and the hover band run to the viewport edges (the screen clips them).
//   cols 2: hairline grid of two columns (topic index).
// A label (number) is aligned to the first text line of the row.
interface Item {
  href?: string;
  external?: boolean;
  label?: string;
  title: string;
  text?: string;
  meta?: string;
  tag?: string;
  go?: string;
  arrow?: boolean;
}
interface Props {
  items: Item[];
  titleRole?: 'card-title' | 'text';
  as?: 'ul' | 'ol';
  bleed?: boolean;
  cols?: 1 | 2;
  newTab?: string;
}
const { items, titleRole = 'card-title', as: Tag = 'ul', bleed = false, cols = 1, newTab = 'opens in a new tab' } = Astro.props;
---
<Tag class:list={['rows', bleed && 'is-bleed', cols === 2 && 'is-two']}>
  {
    items.map((it) => {
      const Row = it.href ? 'a' : 'div';
      const ext = it.external ? { target: '_blank', rel: 'noopener' } : {};
      return (
        <li class="item">
          <Row class:list={['row', it.href && 'is-link', it.label && 'has-label']} href={it.href} {...ext}>
            {it.label && <span class="t-label label">{it.label}</span>}
            <span class="body">
              <span class={`t-${titleRole} name`}>{it.title}</span>
              {it.text && <span class="t-text text">{it.text}</span>}
              {it.meta && <span class="t-small meta">{it.meta}</span>}
              {it.tag && <span class="t-label tag">{it.tag}</span>}
            </span>
            {it.go && <span class="t-small go">{it.go} <span class="arr" aria-hidden="true">→</span></span>}
            {it.arrow && <svg class="down" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v13M4 11l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>}
            {it.external && <span class="sr-only"> {newTab}</span>}
          </Row>
        </li>
      );
    })
  }
</Tag>

<style>
  .rows { position: relative; display: grid; margin: 0; padding: 0; list-style: none; border-top: var(--bw-1) solid var(--c-border-strong); }
  .item { min-width: 0; border-bottom: var(--bw-1) solid var(--c-border); }
  .row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-12);
    align-items: start;
    padding: var(--s-24) 0;
    color: var(--c-text);
    text-decoration: none;
  }
  .has-label { grid-template-columns: minmax(0, auto) minmax(0, 1fr); align-items: baseline; column-gap: var(--s-12); }
  .body { display: grid; gap: var(--s-12); min-width: 0; }
  .label { color: var(--c-accent); overflow-wrap: anywhere; }
  .name, .text, .meta, .tag { overflow-wrap: anywhere; }
  .text { color: var(--c-text-2); }
  .meta { color: var(--c-text-3); }
  .tag { justify-self: start; color: var(--c-accent); }
  .go { display: inline-flex; align-items: center; gap: var(--s-8); color: var(--c-accent); }
  .arr { display: inline-block; transition: transform var(--ease); }
  .down { color: var(--c-accent); transition: transform var(--ease); }
  .is-link:hover .arr { transform: translateX(var(--s-8)); }
  .is-link:hover .down { transform: translateY(var(--s-8)); }
  .is-link:hover, .is-link:focus-visible { background: var(--c-surface); }

  /* bleed: hairlines and the hover band run to the viewport edges */
  .is-bleed .item { border-bottom: 0; }
  .is-bleed::before, .is-bleed .row::after, .is-bleed .row::before {
    content: '';
    position: absolute;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
  }
  .is-bleed::before { top: calc(var(--bw-1) * -1); height: var(--bw-1); background: var(--c-border-strong); }
  .is-bleed .row::after { bottom: 0; height: var(--bw-1); background: var(--c-border); }
  .is-bleed .row::before { top: 0; bottom: var(--bw-1); z-index: -1; transition: background-color var(--ease), box-shadow var(--ease); }
  .is-bleed .is-link:hover, .is-bleed .is-link:focus-visible { background: transparent; }
  .is-bleed .is-link:hover::before, .is-bleed .is-link:focus-visible::before { background: var(--color-inverse-hover); box-shadow: inset var(--bw-3) 0 0 var(--c-accent); }

  /* two columns: a hairline grid */
  .is-two { border: var(--bw-1) solid var(--c-border-strong); gap: var(--bw-1); background: var(--c-border-strong); }
  .is-two .item { border: 0; background: var(--c-bg); }
  .is-two .row { padding: var(--s-24); }

  @media (min-width: 768px) {
    .row { grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: var(--s-40); }
    .has-label { grid-template-columns: minmax(0, auto) minmax(0, 1fr) auto; align-items: baseline; }
    .is-two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-link:hover .arr, .is-link:hover .down { transform: none; }
  }
</style>
