---
// One text element with exactly one role (CLAUDE.md rule 3 + D1). Colour comes from the screen's colour roles.
import type { Role } from '../../lib/scale';

interface Props {
  role?: Role;
  as?: 'p' | 'span' | 'div' | 'h1' | 'h2' | 'h3' | 'h4' | 'dt' | 'dd' | 'li' | 'figcaption' | 'blockquote' | 'legend' | 'label' | 'small' | 'time' | 'address' | 'summary';
  tone?: 'default' | 'muted' | 'subtle' | 'accent' | 'ok' | 'warn' | 'danger';
  class?: string;
  [attr: string]: unknown;
}
const { role = 'text', as: Tag = 'p', tone = 'default', class: className, style: _style, ...rest } = Astro.props;
---
<Tag class:list={[`t-${role}`, `tx-${tone}`, className]} {...rest}><slot /></Tag>

<style>
  .tx-muted { color: var(--c-text-2); }
  .tx-subtle { color: var(--c-text-3); }
  .tx-accent { color: var(--c-accent); }
  .tx-ok { color: var(--color-ok); }
  .tx-warn { color: var(--color-warn); }
  .tx-danger { color: var(--color-danger); }
</style>
