---
// Numbered stage list beside a form: label + text per row. The form script marks the current (aria-current) and done rows.
interface Props {
  items: { label: string; text: string }[];
  /** Hidden from assistive tech when the form already shows the step. */
  decorative?: boolean;
  dataS?: boolean;
}
const { items, decorative = false, dataS = false } = Astro.props;
---
<ul class="stage" aria-hidden={decorative ? 'true' : undefined}>
  {items.map((s, i) => <li class="t-small" data-s={dataS ? i + 1 : undefined}><span class="t-label">{s.label}</span>{s.text}</li>)}
</ul>

<style>
  .stage { display: grid; margin: 0; padding: 0; list-style: none; border-top: var(--bw-1) solid var(--c-border-strong); }
  .stage li { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-8); padding: var(--s-12) 0; border-bottom: var(--bw-1) solid var(--c-border-strong); color: var(--c-text-3); transition: color var(--ease); }
  .stage li span { color: var(--c-accent); }
  .stage li[aria-current='step'] { color: var(--c-text); }
  .stage li.done { color: var(--c-text-2); }
</style>
