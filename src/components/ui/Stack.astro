---
// Vertical stack. The gap is a name from the scale (D5): 8, 12, 16, 24, 32, 40.
import { assertGap, type Gap } from '../../lib/scale';

interface Props {
  gap?: Gap;
  as?: 'div' | 'ul' | 'ol' | 'li' | 'section' | 'article' | 'figure' | 'form' | 'dl' | 'nav' | 'aside' | 'header' | 'fieldset' | 'address';
  align?: 'start' | 'center' | 'stretch' | 'end';
  class?: string;
  [attr: string]: unknown;
}
const { gap = 16, as: Tag = 'div', align = 'stretch', class: className, style: _style, ...rest } = Astro.props;
assertGap(gap, 'Stack');
---
<Tag class:list={['stack', `g-${gap}`, `a-${align}`, className]} {...rest}><slot /></Tag>

<style>
  .stack { display: grid; min-width: 0; margin: 0; padding: 0; list-style: none; }
  .g-8 { gap: var(--s-8); }
  .g-12 { gap: var(--s-12); }
  .g-16 { gap: var(--s-16); }
  .g-24 { gap: var(--s-24); }
  .g-32 { gap: var(--s-32); }
  .g-40 { gap: var(--s-40); }
  .a-start { justify-items: start; }
  .a-center { justify-items: center; }
  .a-end { justify-items: end; }
  .a-stretch { justify-items: stretch; }
</style>
