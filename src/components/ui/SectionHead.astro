---
// The only way to write a section heading (CLAUDE.md rules 1, 3, 4, 6). No eyebrow above any heading.
// title -> text 16, head -> content 40 (32 when buttons follow the text).
interface Props {
  title?: string;
  lead?: string | string[];
  /** Short secondary line under the text (small role). */
  meta?: string;
  id?: string;
  level?: 1 | 2;
  /** What follows the head: the content (40px) or a row of buttons (32px). */
  next?: 'content' | 'actions';
  /** First screen: title width --hero-title-max. */
  hero?: boolean;
}
const { title, lead, meta, id, level = 2, next = 'content', hero = false } = Astro.props;
const H = `h${level}`;
---
{
  (title || lead) && (
    <header class:list={['head', `next-${next}`, hero && 'is-hero']}>
      {
        title && (
          <H class="title" id={id}>
            {title}
          </H>
        )
      }
      {lead && [lead].flat().map((l) => <p class="t-text lead">{l}</p>)}
      {meta && <p class="t-small meta">{meta}</p>}
    </header>
  )
}

<style>
  .head {
    display: grid;
    gap: var(--space-4);
    max-width: var(--container-prose);
    margin: 0 0 var(--space-10);
  }
  .head.next-actions { margin-bottom: var(--space-8); }
  .head > * { margin: 0; }
  .is-hero { max-width: none; }
  .is-hero .title { max-width: var(--hero-title-max); }
  .is-hero .lead { max-width: var(--container-prose); }
  .lead { color: var(--c-text-2); }
  .meta { color: var(--c-text-3); }
</style>
