---
// The only way to write a section heading (CLAUDE.md rules 1, 3, 4, 6). No eyebrow above any heading.
// title -> text 16 (inside .lines); text -> list / buttons 32 (slots); head -> content 40 (Section gap).
interface Props {
  title?: string;
  lead?: string | string[];
  /** Short secondary line under the text (small role). */
  meta?: string;
  id?: string;
  level?: 1 | 2;
  /** First screen: title width --hero-title-max. */
  hero?: boolean;
}
const { title, lead, meta, id, level = 2, hero = false } = Astro.props;
const H = `h${level}`;
const extras = Astro.slots.has('default') ? (await Astro.slots.render('default')).trim() : '';
const actions = Astro.slots.has('actions') ? (await Astro.slots.render('actions')).trim() : '';
---
{
  (title || lead) && (
    <header class:list={['head', hero && 'is-hero']}>
      <div class="lines">
        {title && <H class="title" id={id}>{title}</H>}
        {lead && [lead].flat().map((l) => <p class="t-text lead">{l}</p>)}
        {meta && <p class="t-small meta">{meta}</p>}
      </div>
      {extras && <div class="extras" set:html={extras} />}
      {actions && <div class="actions" set:html={actions} />}
    </header>
  )
}

<style>
  .head { display: grid; gap: var(--s-32); max-width: var(--container-prose); }
  .lines { display: grid; gap: var(--s-16); }
  .extras { display: grid; gap: var(--s-32); }
  .is-hero { max-width: none; }
  .is-hero .title { max-width: var(--hero-title-max); }
  .lead { color: var(--c-text-2); }
  .meta { color: var(--c-text-3); }
</style>
