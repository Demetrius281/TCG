---
// The only way to write a section heading (CLAUDE.md rules 1, 4, 6).
// label -> title 16, title -> lead 16, head -> content 40 (32 when buttons follow the lead).
interface Props {
  label?: string;
  title?: string;
  lead?: string | string[];
  id?: string;
  level?: 1 | 2;
  /** What follows the head: the content (40px) or a row of buttons (32px). */
  next?: 'content' | 'actions';
  /** Hero: display-size title and a title width of --hero-title-max. */
  display?: boolean;
  hero?: boolean;
  /** Lighter second line inside the title (hero). */
  subtitle?: string;
}
const { label, title, lead, id, level = 2, next = 'content', display = false, hero = false, subtitle } = Astro.props;
const H = `h${level}`;
---
{
  (label || title || lead) && (
    <header class:list={['head', `next-${next}`, hero && 'is-hero']}>
      {label && <p class="t-label label">{label}</p>}
      {
        title && (
          <H class:list={['title', display && 't-display']} id={id}>
            {subtitle ? <><span>{title}</span><span class="t-lead sub">{subtitle}</span></> : title}
          </H>
        )
      }
      {lead && [lead].flat().map((l) => <p class="t-lead lead">{l}</p>)}
    </header>
  )
}

<style>
  .head {
    display: grid;
    gap: var(--space-4);
    max-width: var(--container-prose);
    margin: 0 0 var(--space-10);
  }
  .head.next-actions { margin-bottom: var(--space-8); }
  .head > * { margin: 0; }
  .is-hero { max-width: none; }
  .is-hero .title { max-width: var(--hero-title-max); }
  .is-hero .lead { max-width: var(--container-prose); }
  .sub { display: block; margin-top: var(--space-4); font-weight: 400; letter-spacing: normal; color: var(--c-text-2); }
  .label { color: var(--c-accent); }
  .lead { color: var(--c-text-2); }
</style>
