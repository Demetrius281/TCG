---
// Big figures with their labels: 2 columns on mobile, 4 from 768px. Figure = metric role, label = small role.
interface Props {
  items: { label: string; value: string }[];
}
const { items } = Astro.props;
---
<dl class="stats">
  {
    items.map((m) => (
      <div class="stat">
        <dt class="t-small label">{m.label}</dt>
        <dd class="t-metric value">{m.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; border-top: var(--bw-1) solid var(--c-text); }
  .stat { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--s-8); padding: var(--s-24) var(--s-24) var(--s-24) 0; border-bottom: var(--bw-1) solid var(--c-border); }
  .label { color: var(--c-text-2); }
  .value { color: var(--c-text); }
  @media (min-width: 768px) {
    .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
