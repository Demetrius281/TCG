---
interface Props {
  name: 'home' | 'property-check' | 'regulations' | 'platform';
}
const { name } = Astro.props;
---
<div class="host" data-illustration={name}></div>

<style>
  .host { display: none; min-width: 0; }
  /* The slot reserves the illustration's size before the fragment loads (no layout shift). */
  @media (min-width: 768px) {
    .host { display: block; aspect-ratio: 460 / 512; }
  }
</style>

<script>
  import '../../scripts/illustrations/index.ts';
</script>
