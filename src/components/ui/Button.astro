---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'inverse' | 'text';
  external?: boolean;
  class?: string;
  [attr: `data-${string}`]: string | undefined;
}
const { href, variant = 'primary', external = false, class: className, style: _style, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const attrs = href
  ? { href, ...(external ? { target: '_blank', rel: 'noopener' } : {}) }
  : { type: 'button' };
---
<Tag class:list={['btn', `btn-${variant}`, className]} {...attrs} {...rest}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-8);
    width: 100%;
    height: var(--control-h);
    padding: 0 var(--s-24);
    border: var(--bw-1) solid transparent;
    border-radius: var(--radius);
    text-decoration: none;
    cursor: pointer;
    transition: background var(--ease), color var(--ease), border-color var(--ease), box-shadow var(--ease), transform var(--ease);
  }
  .btn:hover { box-shadow: var(--shadow-lift); transform: translateY(var(--lift)); }
  .btn-primary { background: var(--color-accent); color: var(--color-surface); }
  .btn-primary:hover { background: var(--color-accent-hover); }
  .btn-secondary { background: transparent; color: var(--color-text); border-color: var(--color-border-strong); }
  .btn-secondary:hover { background: var(--color-accent-hover); color: var(--color-surface); border-color: var(--color-accent-hover); }
  .btn-inverse { background: var(--color-accent-inverse); color: var(--color-inverse); }
  .btn-inverse:hover { background: var(--color-surface); color: var(--color-inverse); }
  .btn-text { width: auto; padding: 0; background: transparent; color: var(--c-accent, var(--color-accent)); text-decoration: underline; text-underline-offset: var(--underline-offset); }
  .btn-text:hover { color: var(--color-accent-hover); box-shadow: none; }

  @media (min-width: 768px) {
    .btn { width: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn:hover { transform: none; }
  }
</style>
