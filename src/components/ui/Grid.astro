---
// The only card grid (CLAUDE.md rule 7): 1 column on mobile, 2 from 768px, `cols` from 1024px.
// Gap is --grid-gap (16 mobile / 32 desktop). Cards and cells inside it cannot change the gap.
interface Props {
  cols?: 2 | 3 | 4;
  as?: 'ul' | 'div' | 'ol' | 'dl';
  class?: string;
  [attr: string]: unknown;
}
const { cols = 3, as: Tag = 'ul', class: className, ...rest } = Astro.props;
---
<Tag class:list={['grid', `cols-${cols}`, className]} {...rest}><slot /></Tag>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); position: relative; gap: var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  .grid > * { min-width: 0; }
  @media (min-width: 768px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
