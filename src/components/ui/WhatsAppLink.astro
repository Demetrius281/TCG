---
import Button from './Button.astro';
import { whatsappHref, type WhatsAppKey } from '../../data/whatsapp';

interface Props {
  message: WhatsAppKey;
  variant?: 'primary' | 'secondary' | 'inverse' | 'text';
  class?: string;
  [attr: `data-${string}`]: string | undefined;
}
const { message, variant = 'primary', class: className, style: _style, ...rest } = Astro.props;
---
<Button href={whatsappHref(message)} variant={variant} external class={className} {...rest}><slot /></Button>
