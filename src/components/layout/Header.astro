---
import MobileMenu from './MobileMenu.astro';
import Action from '../ui/Action.astro';
import { headerNav, headerCta, isGroup } from '../../data/navigation';
import { site } from '../../data/site';

interface Props {
  /** Replaces the default WhatsApp consultation button, for pages whose main action is on the page itself. */
  cta?: { label: string; href: string };
}
const { cta } = Astro.props;
const action = cta ?? { label: headerCta.label, message: headerCta.message };
// build.format 'file' emits /name.html; compare on the clean URL.
const current = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const isCurrent = (href: string) =>
  href === '/' ? current === '/' : current === href || current.startsWith(href + '/');
---
<header class="header" data-header>
  <div class="bar">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <picture>
        <source media="(min-width: 768px)" srcset="/assets/brand/logos/tcg-horizontal-full-color.svg" />
        <img src="/assets/brand/logos/tcg-horizontal-short-color.svg" alt={site.name} width="96" height="24" />
      </picture>
    </a>

    <nav class="desktop" aria-label="Main">
      <ul class="menu">
        {
          headerNav.map((item, i) =>
            isGroup(item) ? (
              <li class="dd" data-dropdown>
                <button
                  class="link"
                  type="button"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls={`dd-${i}`}
                  aria-current={item.items.some((l) => isCurrent(l.href)) ? 'true' : undefined}
                >
                  {item.label}
                  <span class="chev" aria-hidden="true"></span>
                </button>
                <ul class="drop" id={`dd-${i}`}>
                  {item.items.map((l) => (
                    <li>
                      <a class="droplink" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a class="link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="cta"><Action action={action} /></div>

    <button
      class="toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
  <MobileMenu current={current} action={action} />
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-bg);
    border-bottom: var(--bw-1) solid var(--color-border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    width: min(100% - 2 * var(--gutter), var(--container));
    height: var(--header-h);
    margin-inline: auto;
  }
  .brand { display: block; line-height: var(--lh-reset); }
  .brand img { height: var(--space-6); width: auto; }
  .desktop, .cta { display: none; }
  .toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: calc(var(--space-10) + var(--space-1));
    min-height: calc(var(--space-10) + var(--space-1));
    margin-right: calc(var(--space-3) * -1);
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: var(--radius);
    color: var(--color-text);
    cursor: pointer;
  }
  .icon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: var(--space-6);
    height: var(--space-5);
  }
  .icon span {
    display: block;
    height: var(--bw-2);
    background: currentColor;
    transition: transform var(--ease), opacity var(--ease);
  }
  .toggle[aria-expanded='true'] .icon span:nth-child(1) {
    transform: translateY(calc(var(--space-5) / 2 - var(--bw-2) / 2)) rotate(45deg);
  }
  .toggle[aria-expanded='true'] .icon span:nth-child(2) { opacity: 0; }
  .toggle[aria-expanded='true'] .icon span:nth-child(3) {
    transform: translateY(calc(var(--space-5) / -2 + var(--bw-2) / 2)) rotate(-45deg);
  }

  @media (min-width: 1024px) {
    .bar { height: var(--header-h-lg); }
    .brand img { height: var(--space-6); }
    .toggle { display: none; }
    .desktop, .cta { display: block; }
    .desktop { margin-inline: auto var(--space-6); }
    .menu { display: flex; align-items: center; gap: var(--space-2); }
    .link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-height: var(--control-h-lg);
      padding: 0 var(--space-4);
      background: none;
      border: 0;
      color: var(--color-text-2);
      font-size: var(--fs-small);
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      transition: color var(--ease);
    }
    .link:hover, .link[aria-current], .dd[data-open] > .link { color: var(--color-text); }
    .link[aria-current] { box-shadow: inset 0 calc(var(--space-1) / -2) 0 var(--color-accent); }
    .chev {
      width: var(--space-2);
      height: var(--space-2);
      border-right: var(--bw-1) solid currentColor;
      border-bottom: var(--bw-1) solid currentColor;
      transform: translateY(calc(var(--space-1) / -2)) rotate(45deg);
    }
    .dd { position: relative; }
    .drop {
      position: absolute;
      top: 100%;
      left: 0;
      display: none;
      min-width: calc(var(--container-prose) / 2);
      padding: var(--space-2);
      background: var(--color-surface);
      border: var(--bw-1) solid var(--color-border);
      box-shadow: var(--shadow-menu);
    }
    .dd[data-open] > .drop { display: block; }
    .droplink {
      display: flex;
      align-items: center;
      min-height: var(--control-h-lg);
      padding: 0 var(--space-4);
      color: var(--color-text);
      font-size: var(--fs-small);
      text-decoration: none;
    }
    .droplink:hover { background: var(--color-sunken); }
    .droplink[aria-current] { color: var(--color-accent); }
  }
</style>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
    const panel = header.querySelector<HTMLElement>('[data-mobile-menu]')!;
    const dropdowns = Array.from(header.querySelectorAll<HTMLElement>('[data-dropdown]'));

    const setMenu = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      root.classList.toggle('menu-open', open);
    };
    toggle.addEventListener('click', () => setMenu(panel.hidden));
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setMenu(false);
    });

    panel.querySelectorAll<HTMLButtonElement>('[data-mm-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        document.getElementById(btn.getAttribute('aria-controls')!)!.hidden = !open;
      });
    });

    const setDropdown = (dd: HTMLElement, open: boolean) => {
      if (open) dropdowns.forEach((other) => other !== dd && setDropdown(other, false));
      dd.toggleAttribute('data-open', open);
      dd.querySelector('button')!.setAttribute('aria-expanded', String(open));
    };
    const canHover = window.matchMedia('(hover: hover)');
    dropdowns.forEach((dd) => {
      dd.querySelector('button')!.addEventListener('click', () => setDropdown(dd, !dd.hasAttribute('data-open')));
      dd.addEventListener('mouseenter', () => canHover.matches && setDropdown(dd, true));
      dd.addEventListener('mouseleave', () => canHover.matches && setDropdown(dd, false));
    });

    document.addEventListener('click', (e) => {
      dropdowns.forEach((dd) => !dd.contains(e.target as Node) && setDropdown(dd, false));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      dropdowns.forEach((dd) => {
        if (dd.hasAttribute('data-open')) {
          setDropdown(dd, false);
          dd.querySelector('button')!.focus();
        }
      });
      if (!panel.hidden) {
        setMenu(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setMenu(false));
  }
</script>
