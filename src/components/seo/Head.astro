---
import { site } from '../../data/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  ogTitle?: string;
  robots?: string;
  ogType?: string;
  ogDescription?: string;
  extra?: { key: string; value: string; attr: 'name' | 'property' }[];
  jsonLd?: unknown;
}
const { title, description, path = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, ''), ogImage = site.ogImage, ogTitle = title, robots, ogType = 'website', ogDescription = description, extra = [], jsonLd } = Astro.props;
const canonical = new URL(path === '/' ? '/' : path, site.url).href;
const image = new URL(ogImage, site.url).href;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
{robots && <meta name="robots" content={robots} />}
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="preload" href="/fonts/geist-f4634c3b.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/geist-mono-cd5b2578.woff2" as="font" type="font/woff2" crossorigin />
<link rel="icon" href="/assets/brand/2_icons/favicon.ico?v=2" sizes="48x48" />
<link rel="icon" href="/assets/brand/2_icons/favicon.svg?v=2" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/assets/brand/2_icons/apple-touch-icon.png?v=2" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{extra.map((m) => (m.attr === 'property' ? <meta property={m.key} content={m.value} /> : <meta name={m.key} content={m.value} />))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:image" content={image} />
<script is:inline define:vars={{ gtmId: site.gtmId }}>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, 'script', 'dataLayer', gtmId);
</script>
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
