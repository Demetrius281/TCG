---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Rows from '../ui/Rows.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'topics'>, 'type'>;
const { title, items, tone, id, nav } = Astro.props;
---
<Section id={id} nav={nav} tone={tone} labelledby="idx-h">
  <SectionHead title={title} id="idx-h" />
  <Rows as="ol" titleRole="text" items={items.map((t) => ({ href: t.href, label: t.number, title: t.question, meta: t.hint }))} />
</Section>
