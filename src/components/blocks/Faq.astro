---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Accordion from '../ui/Accordion.astro';
import JsonLd from '../seo/JsonLd.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'faq'>, 'type'>;
const { json_ld, layout, heading_id, title, items, tone, id, nav } = Astro.props;
const headId = heading_id ?? `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
// Placeholder entries stay out of structured data.
const published = items.filter((i) => !i.question.includes('[TEXT]') && !i.answer.includes('[TEXT]'));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: published.map((i) => ({
    '@type': 'Question',
    name: i.question,
    acceptedAnswer: { '@type': 'Answer', text: i.answer },
  })),
};
const split = layout === 'split';
---
{
  items.length > 0 && (
    <Section id={id} nav={nav} tone={tone} labelledby={headId} layout={split ? 'split' : 'stacked'}>
      <SectionHead slot={split ? 'head' : undefined} title={title} id={headId} />
      <Accordion items={items} prefix={`faq-${id ?? headId}`} />
      {json_ld && published.length > 0 && <JsonLd data={jsonLd} />}
    </Section>
  )
}
