---
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Text from '../ui/Text.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'disclosure'>, 'type'>;
const { title, text, href, tone, id } = Astro.props;
---
<Section id={id} tone={tone}>
  <Card as="aside" variant="note">
    {
      text ? (
        <>
          <Text as="h3" role="card-title">{href ? <a href={href}>{title}</a> : title}</Text>
          <Text role="small" tone="muted">{text}</Text>
        </>
      ) : (
        <Text role="small">{href ? <a href={href}>{title}</a> : title}</Text>
      )
    }
  </Card>
</Section>
