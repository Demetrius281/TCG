---
import Section from '../ui/Section.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'disclosure'>, 'type'>;
const { title, text, href, tone } = Astro.props;
---
<Section tone={tone}>
  <aside class="box">
    <h2 class="t-h4 title">
      {href ? <a href={href}>{title}</a> : title}
    </h2>
    <p class="t-small text">{text}</p>
  </aside>
</Section>

<style>
  .box {
    display: grid;
    gap: var(--space-2);
    max-width: var(--container-prose);
    padding-left: var(--space-5);
    border-left: var(--bw-2) solid var(--c-accent);
  }
  .title a { color: inherit; }
  .text { color: var(--c-text-2); }
</style>
