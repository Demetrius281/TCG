---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Carousel from '../ui/Carousel.astro';
import Card from '../ui/Card.astro';
import Cluster from '../ui/Cluster.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'testimonials'>, 'type'>;
const { title, items, tone, id } = Astro.props;
const headId = `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---
<Section id={id} tone={tone} labelledby={headId}>
  <SectionHead title={title} id={headId} />
  <Carousel label={title}>
    {
      items.map((t) => (
        <Card item as="figure">
          <Text as="blockquote" tone="muted">“{t.quote}”</Text>
          <Cluster slot="foot" as="figcaption" gap={16} align="start" nowrap>
            {t.photo && <img src={t.photo} alt="" width="48" height="48" loading="lazy" decoding="async" />}
            <Stack gap={8} as="div">
              <Text as="span" role="card-title">{t.name}</Text>
              {t.meta && <Text as="span" role="small" tone="subtle">{t.meta}</Text>}
            </Stack>
          </Cluster>
        </Card>
      ))
    }
  </Carousel>
</Section>
