---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Action from '../ui/Action.astro';
import Grid from '../ui/Grid.astro';
import Card from '../ui/Card.astro';
import Cluster from '../ui/Cluster.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'comparison'>, 'type'>;
const { title, highlight, other, closing, tone = 'inverse', id } = Astro.props;
---
<Section id={id} tone={tone} labelledby="compare-title">
  <SectionHead title={title} id="compare-title" />
  <Grid as="div" cols={2}>
    <Card as="div" accent>
      <Cluster justify="between" gap={8}>
        <Text as="h3" role="card-title">{highlight.title}</Text>
        <Text as="span" role="label" tone="accent">{highlight.tag}</Text>
      </Cluster>
      <Cluster as="dl" gap={32} align="start">
        {highlight.facts.map((f) => <Stack gap={8} as="div"><Text as="dt" role="label" tone="subtle">{f.label}</Text><Text as="dd" role="card-title" tone="accent">{f.value}</Text></Stack>)}
      </Cluster>
      <Text tone="muted">{highlight.text}</Text>
      <Action slot="actions" action={highlight.action} fallbackVariant={tone === 'inverse' ? 'inverse' : 'primary'} />
    </Card>
    <Card as="div">
      <Text as="h3" role="card-title">{other.title}</Text>
      <Cluster as="dl" gap={32} align="start">
        {other.facts.map((f) => <Stack gap={8} as="div"><Text as="dt" role="label" tone="subtle">{f.label}</Text><Text as="dd" role="card-title" tone="muted">{f.value}</Text></Stack>)}
      </Cluster>
      <Text role="small" tone="muted">{other.text}</Text>
    </Card>
  </Grid>
  <Text role="card-title">{closing}</Text>
</Section>
