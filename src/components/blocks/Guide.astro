---
import Section from '../ui/Section.astro';
import { inline } from '../../lib/inline';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'guide'>, 'type'>;
const { label, chain, heading_id, title, lead, answer, parts, tone, id, nav } = Astro.props;
const text = (v: string | { title: string; text: string }) => (typeof v === 'string' ? v : null);
---
<Section id={id} nav={nav} tone={tone} labelledby={heading_id}>
  {
    (label || title) && (
      <div class="sec-head">
        {
          label && (
            <div class="eyebrow-row">
              <span class="t-label eyebrow">{label}</span>
              {chain && <span class="chainpos">{[1, 2, 3, 4, 5, 6].map((n) => <i class={chain.includes(n) ? 'on' : undefined}></i>)}</span>}
            </div>
          )
        }
        {title && <h2 id={heading_id}>{title}</h2>}
      </div>
    )
  }
  {lead && <p class="t-lead lead">{lead}</p>}
  {answer && <p class="answer">{answer}</p>}

  {
    parts.map((p) => {
      switch (p.part) {
        case 'prose':
          return <div class="prose">{p.paragraphs.map((t) => <p set:html={inline(t)} />)}</div>;
        case 'heading':
          return <h3 class={p.variant === 'base' ? 'base-h' : 'h3'} id={p.id}>{p.text}</h3>;
        case 'note':
          return p.variant === 'callout' ? (
            <div class="colour-note"><p>{p.strong && <strong>{p.strong}</strong>}{p.text}</p></div>
          ) : (
            <p class={p.variant} set:html={inline(p.text)} />
          );
        case 'terms':
          return (
            <div class={p.variant}>
              {p.items.map((i) => <div><span class="ab">{i.abbr}</span><span class="t-caption full">{i.full}</span><p class="t-small">{i.text}</p></div>)}
            </div>
          );
        case 'codes':
          return (
            <ul class="itbx">
              {p.items.map((i) => <li class={i.kind}><span class="L">{i.letter}</span><b>{i.title}</b><p class="t-small">{i.text}</p></li>)}
            </ul>
          );
        case 'list': {
          const Tag = p.variant === 'steps4' ? 'ol' : 'ul';
          return (
            <Tag class={p.variant}>
              {p.items.map((i) => (text(i) !== null ? <li set:html={inline(text(i)!)} /> : <li><b>{(i as any).title}</b><span class="t-small">{(i as any).text}</span></li>))}
            </Tag>
          );
        }
        case 'cards':
          return (
            <div class={`cards cards-${p.variant}`}>
              {p.items.map((i) => (
                <div class:list={[i.draft && 'draft']}>
                  {i.tag && p.variant !== 'imb' && p.variant === 'rules' && <span class={`t-label tag tag-${i.tag.kind}`}>{i.tag.label}</span>}
                  {i.tag && p.variant === 'plan' && <span class={`t-label tag tag-${i.tag.kind}`}>{i.tag.label}</span>}
                  {p.variant === 'rules' ? (
                    <>
                      <h4>{i.title}</h4>
                      <span class="t-caption k">{i.kicker}</span>
                    </>
                  ) : (
                    <>
                      <span class="t-caption k">{i.kicker}</span>
                      <h4>{i.title}</h4>
                    </>
                  )}
                  <p class="t-small">{i.text}</p>
                </div>
              ))}
            </div>
          );
        case 'table':
          return (
            <div class:list={['tbl-wrap', p.variant === 'audit' && 'audit-t']}>
              <table class:list={['t', ['layers', 'scenarios', 'kbli'].includes(p.variant) && 'stack', p.variant === 'pma' && 'pma']}>
                <thead>
                  <tr>{p.columns.map((c) => <th scope="col">{c}</th>)}</tr>
                </thead>
                {p.groups.map((g) => (
                  <tbody>
                    {g.name && <tr class="grp"><th colspan={p.columns.length} scope="colgroup">{g.name}</th></tr>}
                    {g.rows.map((r) => (
                      <tr class:list={[r.highlight && 'hl']}>
                        {r.cells.map((c, i) =>
                          i === 0 ? (
                            <th scope="row" class:list={[p.variant === 'kbli' && 'code-cell']} set:html={inline(c)} />
                          ) : (
                            <td data-label={p.columns[i]} set:html={inline(c)} />
                          ),
                        )}
                      </tr>
                    ))}
                  </tbody>
                ))}
              </table>
            </div>
          );
        case 'compare':
          return (
            <div class="cmp">
              {p.items.map((i) => (
                <div class={i.kind}>
                  <div class="cmp-h"><b>{i.abbr}</b><span>{i.full}</span></div>
                  <dl>{i.rows.map((r) => <><dt>{r.label}</dt><dd>{r.value}</dd></>)}</dl>
                </div>
              ))}
            </div>
          );
        case 'path':
          return (
            <ol class="path">
              {p.items.map((i) => (
                <li>
                  <span class="st"><small>{i.step_label}</small><b>{i.step}</b></span>
                  <div><h4>{i.title}</h4><p class="t-small">{i.text}</p><span class="t-label zone">{i.zone}</span></div>
                </li>
              ))}
            </ol>
          );
        case 'chain':
          return (
            <ol class="chain">
              {p.items.map((i, n) => <li><span class="node">{n + 1}</span><h3>{i.title}</h3><p class="t-small">{i.text}</p></li>)}
            </ol>
          );
        case 'kbli_shift':
          return (
            <div class="kbli-shift">
              <div class="code old"><b>{p.old.code}</b><span><strong>{p.old.title}</strong>{p.old.note}</span></div>
              <div class="arr" aria-hidden="true"><svg viewBox="0 0 64 24"><path d="M0 12h60M50 3l10 9-10 9" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>{p.arrow}</div>
              <div class="code new"><b>{p.current.code}</b><span><strong>{p.current.title}</strong>{p.current.note}</span></div>
            </div>
          );
        case 'split':
          return (
            <div class="split">
              {p.items.map((i) => (
                <div><h3 class="h3" id={i.id}>{i.title}</h3><div class="prose">{i.paragraphs.map((t) => <p set:html={inline(t)} />)}</div></div>
              ))}
            </div>
          );
        case 'formula':
          return (
            <div class="formula">
              {p.items.map((i, n) => (n % 2 === 1 ? <div class="op">{i}</div> : <div class:list={[n === p.items.length - 1 && 'res']}><b>{i}</b></div>))}
            </div>
          );
        case 'taxbox':
          return (
            <div class="taxbox" id={p.id}>
              <div><div class="eyebrow-row"><span class="t-label eyebrow">{p.label}</span></div><h3 class="h3">{p.title}</h3></div>
              <div class="prose">{p.paragraphs.map((t) => <p set:html={inline(t)} />)}</div>
            </div>
          );
        case 'screen':
          return (
            <div class="screen">
              {p.columns.map((c) => <div><h4>{c.title}</h4><ul>{c.items.map((i) => <li class="t-small">{i}</li>)}</ul></div>)}
            </div>
          );
        case 'results':
          return (
            <div class="results">
              {p.items.map((i) => <div class={i.kind}><span class="mk"></span><b>{i.title}</b><p class="t-small">{i.text}</p></div>)}
            </div>
          );
        case 'timeline':
          return (
            <ol class="tl">
              {p.items.map((i, n) => (
                <li>
                  <span class="no">{n + 1}</span>
                  <div><h3>{i.title}</h3><p class="t-small" set:html={inline(i.text)} /></div>
                  <div class="meta"><span class={`t-label tag tag-${i.tag.kind}`}>{i.tag.label}</span><span class="t-caption when">{i.when}</span></div>
                </li>
              ))}
            </ol>
          );
      }
    })
  }
</Section>

<style>
  .sec-head { display: grid; gap: var(--space-3); max-width: var(--container-prose); margin-bottom: var(--space-6); }
  .eyebrow-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .eyebrow { color: var(--c-accent); }
  .chainpos { display: inline-flex; gap: var(--space-1); }
  .chainpos i { display: block; width: var(--space-4); height: var(--bw-2); background: var(--c-border-strong); }
  .chainpos i.on { background: var(--c-accent); }
  .lead { color: var(--c-text-2); max-width: var(--container-prose); margin-bottom: var(--space-6); }
  .answer { max-width: var(--container-prose); margin-bottom: var(--space-5); padding-block: var(--space-3); border-block: var(--bw-1) solid var(--c-border-strong); font-size: var(--fs-lead); line-height: var(--lh-lead); font-weight: 500; color: var(--c-text); }
  .prose { display: grid; gap: var(--space-4); max-width: var(--container-prose); margin-bottom: var(--space-6); color: var(--c-text-2); }
  .prose :global(strong) { color: var(--c-text); font-weight: 500; }
  .prose :global(a), .tl :global(a), .answer :global(a) { color: var(--c-accent); }
  .h3, .base-h { margin: var(--space-10) 0 var(--space-5); }
  .pull { margin-top: var(--space-6); padding: var(--space-5); border-left: var(--bw-2) solid var(--c-accent); background: var(--c-surface); font-size: var(--fs-h4); font-weight: 500; }
  .tbl-note { margin-top: var(--space-3); max-width: var(--container-prose); color: var(--c-text-3); }
  .sub-lead { margin: var(--space-6) 0 var(--space-3); font-weight: 500; }
  .colour-note { margin-block: var(--space-4) var(--space-6); padding: var(--space-4) var(--space-5); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); }
  .colour-note strong { display: block; margin-bottom: var(--space-1); }

  /* grids of small cards */
  .defs, .coef, .itbx, .cards, .screen, .results, .cmp, .split, .chain, .kbli-shift, .steps4 { display: grid; gap: var(--space-3); margin-block: var(--space-4) var(--space-6); }
  .defs > div, .coef > div, .cards > div, .screen > div, .results > div, .cmp > div, .itbx li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
    background: var(--c-surface);
    border: var(--bw-1) solid var(--c-border);
  }
  .ab { font-size: var(--fs-h3); font-weight: 500; color: var(--c-accent); }
  .coef b { font-size: var(--fs-h3); font-weight: 500; color: var(--c-accent); }
  .full { font-family: var(--font-mono); color: var(--c-text-3); }
  p { color: var(--c-text-2); }
  .itbx { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .L { font-size: var(--fs-h2); font-weight: 300; line-height: var(--lh-metric); }
  .itbx .i .L, .itbx .t .L { color: var(--color-ok); }
  .itbx .b .L { color: var(--color-warn); }
  .itbx .x .L { color: var(--color-danger); }
  .itbx b { font-weight: 500; color: var(--c-text); }
  .cards h4 { color: var(--c-text); }
  .k { font-family: var(--font-mono); color: var(--c-text-3); }
  .cards .draft { border-style: dashed; }
  .tag { display: inline-flex; align-items: center; justify-self: start; padding: var(--space-1) var(--space-3); border: var(--bw-1) solid currentColor; }
  .tag-law { color: var(--c-accent); }
  .tag-impl { color: var(--c-text-2); }
  .tag-draft { color: var(--c-text-3); border-style: dashed; }
  .tag-future { color: var(--c-text-3); }
  .tag-enf { color: var(--color-warn); }

  /* lists */
  .plain, .checks, .restr, .feas, .steps4, .facts, .tools, .base { display: grid; gap: var(--space-2); margin-block: var(--space-4) var(--space-6); }
  .plain li, .checks li, .restr li, .feas li { position: relative; padding-left: var(--space-5); color: var(--c-text-2); }
  .plain li::before, .checks li::before, .restr li::before, .feas li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: var(--space-3); height: var(--bw-1); background: var(--c-accent); }
  .steps4 { counter-reset: s; }
  .steps4 li { counter-increment: s; display: flex; gap: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); }
  .steps4 li::before { content: counter(s); font-family: var(--font-mono); color: var(--c-accent); }
  .facts li, .tools li, .base li { display: grid; gap: var(--space-1); padding: var(--space-4) var(--space-5); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); }
  .facts b, .tools b, .base b { font-weight: 500; color: var(--c-text); }
  .facts span, .tools span, .base span { color: var(--c-text-2); }

  /* tables: stacked on small screens, real tables from 768px */
  .tbl-wrap { overflow-x: auto; margin-top: var(--space-4); }
  .t { width: 100%; border-collapse: collapse; background: var(--c-surface); border: var(--bw-1) solid var(--c-border); }
  .t thead { display: none; }
  .t th, .t td { padding: var(--space-3) var(--space-4); text-align: left; vertical-align: top; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--c-text-2); }
  .t th[scope='row'] { color: var(--c-text); font-weight: 500; }
  .t tr { border-top: var(--bw-1) solid var(--c-border); }
  .t tr.hl { background: var(--c-bg); }
  .t .grp th { padding-block: var(--space-3); background: var(--c-bg); color: var(--c-accent); font-family: var(--font-mono); font-size: var(--fs-label); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  .stack tr, .stack th, .stack td { display: block; }
  .stack td::before { content: attr(data-label); display: block; font-family: var(--font-mono); font-size: var(--fs-label); letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-text-3); }
  .code-cell { font-family: var(--font-mono); }
  .t :global(small) { display: block; color: var(--c-text-3); }
  .pma th, .pma td, .audit-t .t th, .audit-t .t td { display: table-cell; }
  .pma thead, .audit-t thead { display: table-header-group; }
  .pma tr, .audit-t tr { display: table-row; }

  /* compare, path, chain, kbli */
  .cmp-h { display: grid; gap: var(--space-1); }
  .cmp-h b { font-size: var(--fs-h3); font-weight: 500; color: var(--c-accent); }
  .cmp-h span { font-family: var(--font-mono); font-size: var(--fs-caption); color: var(--c-text-3); }
  .cmp dl { display: grid; gap: var(--space-1); }
  .cmp dt { font-family: var(--font-mono); font-size: var(--fs-label); letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-text-3); }
  .cmp dd { margin: 0 0 var(--space-3); color: var(--c-text); }
  .path { display: grid; grid-auto-flow: column; grid-auto-columns: min(83%, calc(var(--container-prose) * 0.65)); gap: var(--space-3); overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; padding-bottom: var(--space-4); margin-block: var(--space-4) var(--space-3); }
  .path > li { display: grid; grid-template-columns: var(--space-10) minmax(0, 1fr); gap: var(--space-3); align-content: start; scroll-snap-align: start; padding: var(--space-5); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); min-width: 0; }
  .st { display: grid; justify-items: start; }
  .st small { font-family: var(--font-mono); font-size: var(--fs-label); color: var(--c-text-3); }
  .st b { font-size: var(--fs-h3); font-weight: 500; color: var(--c-accent); }
  .path h4 { color: var(--c-text); }
  .path div { display: grid; gap: var(--space-2); }
  .zone { color: var(--c-accent); }
  .chain { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .chain li { display: grid; gap: var(--space-2); align-content: start; padding-top: var(--space-4); border-top: var(--bw-1) solid var(--c-border-strong); }
  .node { display: inline-flex; align-items: center; justify-content: center; width: var(--space-8); height: var(--space-8); border: var(--bw-1) solid var(--c-accent); border-radius: var(--radius-full); color: var(--c-accent); font-family: var(--font-mono); }
  .chain h3 { font-size: var(--fs-h4); letter-spacing: 0.04em; }
  .kbli-shift { grid-template-columns: minmax(0, 1fr); align-items: center; }
  .kbli-shift .code { display: grid; gap: var(--space-2); padding: var(--space-5); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); }
  .kbli-shift .code b { font-size: var(--fs-h1); font-weight: 300; letter-spacing: -0.03em; line-height: var(--lh-metric); }
  .kbli-shift .old b { color: var(--c-text-3); text-decoration: line-through; }
  .kbli-shift .new b { color: var(--c-accent); }
  .kbli-shift .code span { display: grid; font-size: var(--fs-small); color: var(--c-text-2); }
  .kbli-shift strong { color: var(--c-text); font-weight: 500; }
  .arr { display: flex; align-items: center; justify-content: center; gap: var(--space-3); font-family: var(--font-mono); font-size: var(--fs-label); color: var(--c-text-3); }
  .arr svg { width: calc(var(--space-8) + var(--space-3)); height: var(--space-5); transform: rotate(90deg); }
  .formula { display: grid; gap: var(--space-2); align-items: center; }
  .formula > div { padding: var(--space-4) var(--space-5); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); }
  .formula .op { padding: 0; background: none; border: 0; text-align: center; font-size: var(--fs-h3); color: var(--c-accent); }
  .formula .res { border-color: var(--c-accent); }
  .taxbox { display: grid; gap: var(--space-4); margin-top: var(--space-6); padding: var(--space-6); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); }
  .taxbox .h3 { margin: var(--space-2) 0 0; }
  .taxbox .prose { margin: 0; }
  .screen h4, .screen ul { color: var(--c-text); }
  .screen ul { display: grid; gap: var(--space-2); }
  .screen li { color: var(--c-text-2); }
  .results b { color: var(--c-text); font-weight: 500; }
  .mk { width: var(--space-3); height: var(--space-3); border-radius: var(--radius-full); }
  .results .ok .mk { background: var(--color-ok); }
  .results .cd .mk { background: var(--color-warn); }
  .results .mi .mk { background: var(--color-danger); }
  .split .h3 { margin-top: 0; }

  /* timeline */
  .tl { display: grid; margin-block: var(--space-4) var(--space-8); border-top: var(--bw-1) solid var(--c-border-strong); }
  .tl > li { display: grid; grid-template-columns: var(--space-8) minmax(0, 1fr); gap: var(--space-2) var(--space-4); padding: var(--space-5) 0; border-bottom: var(--bw-1) solid var(--c-border); }
  .no { font-family: var(--font-mono); color: var(--c-accent); }
  .tl h3 { font-size: var(--fs-h4); font-weight: 500; color: var(--c-text); }
  .tl li > div { display: grid; gap: var(--space-2); }
  .meta { grid-column: 2; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); }
  .when { font-family: var(--font-mono); color: var(--c-text-3); }

  @media (min-width: 768px) {
    .defs, .coef, .cards, .screen, .results, .cmp, .split { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .defs, .results, .cards-rules { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .coef { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .itbx { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .chain { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .steps4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .facts, .tools, .base { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kbli-shift { grid-template-columns: 1fr auto 1fr; }
    .arr svg { transform: none; }
    .formula { grid-template-columns: 1fr auto 1fr auto 1fr; }
    .path { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: visible; }
    .tl > li { grid-template-columns: var(--space-8) minmax(0, 1fr) auto; }
    .meta { grid-column: auto; display: grid; justify-items: end; }
    .t thead { display: table-header-group; }
    .stack tr { display: table-row; }
    .stack th, .stack td { display: table-cell; }
    .stack td::before { display: none; }
  }
  @media (min-width: 1024px) {
    .path { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>

<style is:global>
  /* Smooth in-page scrolling on the guide, as on the legacy page. */
  @media (prefers-reduced-motion: no-preference) {
    html:has(.regulations-page) { scroll-behavior: smooth; }
  }
  /* Elements added by the mobile enhancement script (src/scripts/regulations-mobile.js). */
  .regulations-page .mobile-reg-disclosure { border-bottom: var(--bw-1) solid var(--color-border); }
  .regulations-page .mobile-reg-disclosure summary {
    position: relative;
    padding: var(--space-4) var(--space-8) var(--space-4) var(--space-1);
    list-style: none;
    cursor: pointer;
    font-size: var(--fs-body);
    font-weight: 500;
  }
  .regulations-page .mobile-reg-disclosure summary::-webkit-details-marker { display: none; }
  .regulations-page .mobile-reg-disclosure summary::after { content: '+'; position: absolute; right: var(--space-1); top: var(--space-3); color: var(--color-accent); font-size: var(--fs-h3); font-weight: 400; }
  .regulations-page .mobile-reg-disclosure[open] summary::after { content: '−'; }
  .regulations-page .mobile-reg-body { padding: 0 0 var(--space-4); font-size: var(--fs-small); color: var(--color-text-2); }
  .regulations-page .mobile-reg-body p { margin: var(--space-2) 0; }
  .regulations-page .mobile-reg-body a { color: var(--color-accent); }
  .regulations-page .reg-mobile-group { border-top: var(--bw-1) solid var(--color-text); margin-block: var(--space-4) var(--space-6); }
  .regulations-page .reg-mobile-group .tag { margin: 0 0 var(--space-2); }
