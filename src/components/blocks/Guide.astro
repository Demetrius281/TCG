---
// One guide section: heading, answer line and an ordered list of parts. Every part is built from primitives only.
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import List from '../ui/List.astro';
import Grid from '../ui/Grid.astro';
import Card from '../ui/Card.astro';
import Stack from '../ui/Stack.astro';
import Cluster from '../ui/Cluster.astro';
import Table from '../ui/Table.astro';
import Rows from '../ui/Rows.astro';
import Text from '../ui/Text.astro';
import { inline } from '../../lib/inline';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'guide'>, 'type'>;
const { chain, heading_id, title, lead, answer, parts, tone, id, nav } = Astro.props;
const tagTone = { law: 'accent', draft: 'warn', impl: 'muted', future: 'subtle', enf: 'danger' } as const;
const codeTone = { i: 'ok', t: 'muted', b: 'warn', x: 'danger' } as const;
const resultTone = { ok: 'ok', cd: 'warn', mi: 'danger' } as const;
const colsFor = (n: number): 2 | 3 | 4 => (n <= 2 ? 2 : n === 4 ? 4 : 3);
const pad = (n: number) => String(n).padStart(2, '0');
// A subheading stays with the part it introduces (card-title -> text 12, D6); every other gap between parts is 24.
const groups: (typeof parts)[] = [];
for (let i = 0; i < parts.length; i++) {
  if (parts[i].part === 'heading' && parts[i + 1]) { groups.push([parts[i], parts[i + 1]]); i++; } else groups.push([parts[i]]);
}
---
<Section id={id} nav={nav} tone={tone} labelledby={heading_id}>
  <SectionHead title={title} lead={lead} id={heading_id} />
  {chain && <Text role="label" tone="subtle">{chain.map(pad).join(' · ')}</Text>}
  {answer && <Card variant="note"><Text>{answer}</Text></Card>}
  <Stack gap={24}>
    {
      groups.map((g) => <Stack gap={12}>{g.map((p) => {
        switch (p.part) {
          case 'prose':
            return <Stack gap={16}>{p.paragraphs.map((t) => <Text tone="muted"><Fragment set:html={inline(t)} /></Text>)}</Stack>;
          case 'heading':
            return <Text as="h3" role="card-title" id={p.id}>{p.text}</Text>;
          case 'note':
            return p.variant === 'callout' ? (
              <Card variant="note"><Text role="small">{p.strong && `${p.strong} `}{p.text}</Text></Card>
            ) : p.variant === 'pull' ? (
              <Card variant="note"><Text><Fragment set:html={inline(p.text)} /></Text></Card>
            ) : (
              <Text role={p.variant === 'tbl-note' ? 'small' : 'text'} tone={p.variant === 'tbl-note' ? 'subtle' : 'muted'}><Fragment set:html={inline(p.text)} /></Text>
            );
          case 'terms':
            return (
              <Grid cols={3}>
                {p.items.map((i) => (
                  <Card item>
                    <Text as="span" role="card-title">{i.abbr}</Text>
                    <Text as="span" role="label" tone="subtle">{i.full}</Text>
                    <Text role="small" tone="muted">{i.text}</Text>
                  </Card>
                ))}
              </Grid>
            );
          case 'codes':
            return (
              <Grid cols={4}>
                {p.items.map((i) => (
                  <Card item accent>
                    <Text as="span" role="card-title" tone={codeTone[i.kind]}>{i.letter}</Text>
                    <Text as="span">{i.title}</Text>
                    <Text role="small" tone="muted">{i.text}</Text>
                  </Card>
                ))}
              </Grid>
            );
          case 'list': {
            const plain = p.items.every((i) => typeof i === 'string');
            const numbered = p.variant === 'feas' || p.variant === 'steps4';
            return plain ? (
              <List numbered={numbered}>
                {p.items.map((i) => <li><Text as="span" tone="muted"><Fragment set:html={inline(i as string)} /></Text></li>)}
              </List>
            ) : (
              <Rows titleRole="text" items={p.items.map((i) => ({ title: (i as { title: string }).title, text: (i as { text: string }).text }))} />
            );
          }
          case 'cards':
            return (
              <Grid cols={colsFor(p.items.length)}>
                {p.items.map((i) => (
                  <Card item accent={p.variant === 'plan'}>
                    {i.tag && p.variant !== 'imb' && <Text as="span" role="label" tone={tagTone[i.tag.kind]}>{i.tag.label}</Text>}
                    {p.variant === 'rules' ? (
                      <>
                        <Text as="h3" role="card-title">{i.title}</Text>
                        <Text as="span" role="small" tone="subtle">{i.kicker}</Text>
                      </>
                    ) : (
                      <>
                        <Text as="span" role="small" tone="subtle">{i.kicker}</Text>
                        <Text as="h3" role="card-title">{i.title}</Text>
                      </>
                    )}
                    <Text role="small" tone="muted">{i.text}</Text>
                  </Card>
                ))}
              </Grid>
            );
          case 'table':
            return <Table columns={p.columns} groups={p.groups} stack={['layers', 'scenarios', 'kbli'].includes(p.variant)} />;
          case 'compare':
            return (
              <Grid as="div" cols={2}>
                {p.items.map((i) => (
                  <Card as="div">
                    <Cluster justify="between" gap={8}>
                      <Text as="span" role="card-title">{i.abbr}</Text>
                      <Text as="span" role="label" tone="subtle">{i.full}</Text>
                    </Cluster>
                    <Stack as="dl" gap={12}>
                      {i.rows.map((r) => <Stack gap={8} as="div"><Text as="dt" role="label" tone="subtle">{r.label}</Text><Text as="dd" role="small">{r.value}</Text></Stack>)}
                    </Stack>
                  </Card>
                ))}
              </Grid>
            );
          case 'path':
            return (
              <Grid as="ol" cols={3}>
                {p.items.map((i) => (
                  <Card item>
                    <Cluster justify="between" gap={8}>
                      <Text as="span" role="label" tone="subtle">{i.step_label}</Text>
                      <Text as="span" role="card-title" tone="accent">{i.step}</Text>
                    </Cluster>
                    <Text as="h3" role="card-title">{i.title}</Text>
                    <Text role="small" tone="muted">{i.text}</Text>
                    <Text as="span" role="label" tone="accent">{i.zone}</Text>
                  </Card>
                ))}
              </Grid>
            );
          case 'chain':
            return (
              <Grid as="ol" cols={3}>
                {p.items.map((i, n) => (
                  <Card item>
                    <Text as="span" role="label" tone="accent">{pad(n + 1)}</Text>
                    <Text as="h3" role="card-title">{i.title}</Text>
                    <Text role="small" tone="muted">{i.text}</Text>
                  </Card>
                ))}
              </Grid>
            );
          case 'kbli_shift':
            return (
              <Grid as="div" cols={2}>
                <Card as="div">
                  <Text as="span" role="card-title" tone="subtle">{p.old.code}</Text>
                  <Text as="span">{p.old.title}</Text>
                  <Text role="small" tone="muted">{p.old.note}</Text>
                </Card>
                <Card as="div" accent>
                  <Text as="span" role="label" tone="accent">{p.arrow}</Text>
                  <Text as="span" role="card-title" tone="accent">{p.current.code}</Text>
                  <Text as="span">{p.current.title}</Text>
                  <Text role="small" tone="muted">{p.current.note}</Text>
                </Card>
              </Grid>
            );
          case 'split':
            return (
              <Grid as="div" cols={2}>
                {p.items.map((i) => (
                  <Stack gap={16}>
                    <Text as="h3" role="card-title" id={i.id}>{i.title}</Text>
                    {i.paragraphs.map((t) => <Text tone="muted"><Fragment set:html={inline(t)} /></Text>)}
                  </Stack>
                ))}
              </Grid>
            );
          case 'formula':
            return (
              <Cluster gap={16}>
                {p.items.map((i, n) => <Text as="span" role="card-title" tone={n % 2 === 1 ? 'subtle' : n === p.items.length - 1 ? 'accent' : 'default'}>{i}</Text>)}
              </Cluster>
            );
          case 'taxbox':
            return (
              <Card as="div" id={p.id} accent>
                <Text as="h3" role="card-title">{p.title}</Text>
                {p.paragraphs.map((t) => <Text tone="muted"><Fragment set:html={inline(t)} /></Text>)}
              </Card>
            );
          case 'screen':
            return (
              <Grid as="div" cols={2}>
                {p.columns.map((c) => (
                  <Card as="div">
                    <Text as="h3" role="card-title">{c.title}</Text>
                    <List>{c.items.map((i) => <li><Text as="span" role="small" tone="muted">{i}</Text></li>)}</List>
                  </Card>
                ))}
              </Grid>
            );
          case 'results':
            return (
              <Grid as="div" cols={3}>
                {p.items.map((i) => (
                  <Card as="div" accent>
                    <Text as="span" role="card-title" tone={resultTone[i.kind]}>{i.title}</Text>
                    <Text role="small" tone="muted">{i.text}</Text>
                  </Card>
                ))}
              </Grid>
            );
          case 'timeline':
            return (
              <Stack as="ol" gap={16}>
                {
                  p.items.map((i, n) => (
                    <li>
                      <Card as="div">
                        <Cluster justify="between" gap={8}>
                          <Text as="span" role="label" tone="accent">{pad(n + 1)}</Text>
                          <Text as="span" role="label" tone={tagTone[i.tag.kind]}>{i.tag.label}</Text>
                        </Cluster>
                        <Text as="h3" role="card-title">{i.title}</Text>
                        <Text role="small" tone="muted"><Fragment set:html={inline(i.text)} /></Text>
                        <Text as="span" role="small" tone="subtle">{i.when}</Text>
                      </Card>
                    </li>
                  ))
                }
              </Stack>
            );
        }
      })}</Stack>)
    }
  </Stack>
</Section>
