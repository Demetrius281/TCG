---
import Section from '../ui/Section.astro';
import { inline } from '../../lib/inline';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'guide'>, 'type'>;
const { label, chain, heading_id, title, lead, answer, parts, tone, id, nav } = Astro.props;
const text = (v: string | { title: string; text: string }) => (typeof v === 'string' ? v : null);
---
<Section id={id} nav={nav} tone={tone} labelledby={heading_id}>
  {
    (label || title) && (
      <div class="sec-head">
        {
          label && (
            <div class="eyebrow-row">
              <span class="t-label eyebrow">{label}</span>
              {chain && <span class="chainpos">{[1, 2, 3, 4, 5, 6].map((n) => <i class={chain.includes(n) ? 'on' : undefined}></i>)}</span>}
            </div>
          )
        }
        {title && <h2 id={heading_id}>{title}</h2>}
      </div>
    )
  }
  {lead && <p class="t-lead lead">{lead}</p>}
  {answer && <p class="answer">{answer}</p>}

  {
    parts.map((p) => {
      switch (p.part) {
        case 'prose':
          return <div class="prose">{p.paragraphs.map((t) => <p set:html={inline(t)} />)}</div>;
        case 'heading':
          return <h3 class={p.variant === 'base' ? 'base-h' : 'h3'} id={p.id}>{p.text}</h3>;
        case 'note':
          return p.variant === 'callout' ? (
            <div class="colour-note"><p>{p.strong && <strong>{p.strong}</strong>}{p.text}</p></div>
          ) : (
            <p class={p.variant} set:html={inline(p.text)} />
          );
        case 'terms':
          return (
            <div class={p.variant}>
              {p.items.map((i) => <div><span class="ab">{i.abbr}</span><span class="t-caption full">{i.full}</span><p class="t-small">{i.text}</p></div>)}
            </div>
          );
        case 'codes':
          return (
            <ul class="itbx">
              {p.items.map((i) => <li class={i.kind}><span class="L">{i.letter}</span><b>{i.title}</b><p class="t-small">{i.text}</p></li>)}
            </ul>
          );
        case 'list': {
          const Tag = p.variant === 'steps4' ? 'ol' : 'ul';
          return (
            <Tag class={p.variant}>
              {p.items.map((i) => (text(i) !== null ? <li set:html={inline(text(i)!)} /> : <li><b>{(i as any).title}</b><span class="t-small">{(i as any).text}</span></li>))}
            </Tag>
          );
        }
        case 'cards':
          return (
            <div class={`cards cards-${p.variant}`}>
              {p.items.map((i) => (
                <div class:list={[i.draft && 'draft']}>
                  {i.tag && p.variant !== 'imb' && p.variant === 'rules' && <span class={`t-label tag tag-${i.tag.kind}`}>{i.tag.label}</span>}
                  {i.tag && p.variant === 'plan' && <span class={`t-label tag tag-${i.tag.kind}`}>{i.tag.label}</span>}
                  {p.variant === 'rules' ? (
                    <>
                      <h4>{i.title}</h4>
                      <span class="t-caption k">{i.kicker}</span>
                    </>
                  ) : (
                    <>
                      <span class="t-caption k">{i.kicker}</span>
                      <h4>{i.title}</h4>
                    </>
                  )}
                  <p class="t-small">{i.text}</p>
                </div>
              ))}
            </div>
          );
        case 'table':
          return (
            <div class:list={['tbl-wrap', p.variant === 'audit' && 'audit-t']}>
              <table class:list={['t', ['layers', 'scenarios', 'kbli'].includes(p.variant) && 'stack', p.variant === 'pma' && 'pma']}>
                <thead>
                  <tr>{p.columns.map((c) => <th scope="col">{c}</th>)}</tr>
                </thead>
                {p.groups.map((g) => (
                  <tbody>
                    {g.name && <tr class="grp"><th colspan={p.columns.length} scope="colgroup">{g.name}</th></tr>}
                    {g.rows.map((r) => (
                      <tr class:list={[r.highlight && 'hl']}>
                        {r.cells.map((c, i) =>
                          i === 0 ? (
                            <th scope="row" class:list={[p.variant === 'kbli' && 'code-cell']} set:html={inline(c)} />
                          ) : (
                            <td data-label={p.columns[i]} set:html={inline(c)} />
                          ),
                        )}
                      </tr>
                    ))}
                  </tbody>
                ))}
              </table>
            </div>
          );
        case 'compare':
          return (
            <div class="cmp">
              {p.items.map((i) => (
                <div class={i.kind}>
                  <div class="cmp-h"><b>{i.abbr}</b><span>{i.full}</span></div>
                  <dl>{i.rows.map((r) => <><dt>{r.label}</dt><dd>{r.value}</dd></>)}</dl>
                </div>
              ))}
            </div>
          );
        case 'path':
          return (
            <ol class="path">
              {p.items.map((i) => (
                <li>
                  <span class="st"><small>{i.step_label}</small><b>{i.step}</b></span>
                  <div><h4>{i.title}</h4><p class="t-small">{i.text}</p><span class="t-label zone">{i.zone}</span></div>
                </li>
              ))}
            </ol>
          );
        case 'chain':
          return (
            <ol class="chain">
              {p.items.map((i, n) => <li><span class="node">{n + 1}</span><h3>{i.title}</h3><p class="t-small">{i.text}</p></li>)}
            </ol>
          );
        case 'kbli_shift':
          return (
            <div class="kbli-shift">
              <div class="code old"><b>{p.old.code}</b><span><strong>{p.old.title}</strong>{p.old.note}</span></div>
              <div class="arr" aria-hidden="true"><svg viewBox="0 0 64 24"><path d="M0 12h60M50 3l10 9-10 9" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>{p.arrow}</div>
              <div class="code new"><b>{p.current.code}</b><span><strong>{p.current.title}</strong>{p.current.note}</span></div>
            </div>
          );
        case 'split':
          return (
            <div class="split">
              {p.items.map((i) => (
                <div><h3 class="h3" id={i.id}>{i.title}</h3><div class="prose">{i.paragraphs.map((t) => <p set:html={inline(t)} />)}</div></div>
              ))}
            </div>
          );
        case 'formula':
          return (
            <div class="formula">
              {p.items.map((i, n) => (n % 2 === 1 ? <div class="op">{i}</div> : <div class:list={[n === p.items.length - 1 && 'res']}><b>{i}</b></div>))}
            </div>
          );
        case 'taxbox':
          return (
            <div class="taxbox" id={p.id}>
              <div><div class="eyebrow-row"><span class="t-label eyebrow">{p.label}</span></div><h3 class="h3">{p.title}</h3></div>
              <div class="prose">{p.paragraphs.map((t) => <p set:html={inline(t)} />)}</div>
            </div>
          );
        case 'screen':
          return (
            <div class="screen">
              {p.columns.map((c) => <div><h4>{c.title}</h4><ul>{c.items.map((i) => <li class="t-small">{i}</li>)}</ul></div>)}
            </div>
          );
        case 'results':
          return (
            <div class="results">
              {p.items.map((i) => <div class={i.kind}><span class="mk"></span><b>{i.title}</b><p class="t-small">{i.text}</p></div>)}
            </div>
          );
        case 'timeline':
          return (
            <ol class="tl">
              {p.items.map((i, n) => (
                <li>
                  <span class="no">{n + 1}</span>
                  <div><h3>{i.title}</h3><p class="t-small" set:html={inline(i.text)} /></div>
                  <div class="meta"><span class={`t-label tag tag-${i.tag.kind}`}>{i.tag.label}</span><span class="t-caption when">{i.when}</span></div>
                </li>
              ))}
            </ol>
          );
      }
    })
  }
</Section>

<style>
  .sec-head { display: grid; gap: var(--space-5); max-width: calc(var(--container-prose) * 1.2); margin-bottom: var(--space-6); }
  .eyebrow-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .eyebrow { color: var(--c-text-3); }
  .chainpos { display: inline-flex; gap: var(--space-1); }
  .chainpos i { display: block; width: var(--space-4); height: var(--bw-2); background: var(--c-border-strong); }
  .chainpos i.on { background: var(--c-accent); }
  .lead { color: var(--c-text-2); max-width: var(--container-prose); margin-bottom: var(--space-8); }
  .answer { max-width: calc(var(--container-prose) * 1.2); margin-bottom: var(--space-6); padding: var(--space-5) 0 var(--space-5) var(--space-6); border-left: var(--bw-2) solid var(--c-accent); font-size: var(--fs-lead); line-height: var(--lh-lead); font-weight: 500; color: var(--c-text); }
  .prose { display: grid; gap: var(--space-4); max-width: var(--container-prose); margin-bottom: var(--space-6); color: var(--c-text-2); }
  .prose :global(strong) { color: var(--c-text); font-weight: 600; }
  .prose :global(a), .tl :global(a), .answer :global(a) { color: var(--c-accent); }
  .h3, .base-h { margin: var(--space-12) 0 var(--space-6); }
  .pull { max-width: calc(var(--container-prose) * 1.25); margin-top: var(--space-10); padding: var(--space-6); border: var(--bw-1) solid var(--c-border); border-left: var(--bw-2) solid var(--c-accent); background: var(--c-surface); font-size: var(--fs-h4); line-height: var(--lh-h4); font-weight: 500; color: var(--c-text); }
  .tbl-note { margin-top: var(--space-4); max-width: calc(var(--container-prose) * 1.2); font-family: var(--font-mono); font-size: var(--fs-label); line-height: var(--lh-small); color: var(--c-text-3); }
  .sub-lead { margin: var(--space-8) 0 var(--space-4); color: var(--c-text-2); }
  .colour-note { margin-block: var(--space-4) var(--space-6); padding: var(--space-4) var(--space-5); background: var(--c-bg); border: var(--bw-1) solid var(--c-border); }
  .colour-note strong { display: block; margin-bottom: var(--space-1); }

  /* Hairline-divided grids (legacy "seam"): cells share 1px rules instead of having gaps. */
  .defs, .coef, .cards-rules, .results, .cards-plan, .cards-imb, .base { display: grid; gap: var(--bw-1); background: var(--c-border-strong); border: var(--bw-1) solid var(--c-border-strong); margin-block: var(--space-4) var(--space-6); }
  .defs > div, .coef > div, .cards > div, .results > div, .base li { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-6); background: var(--c-bg); }
  :global(.tone-sunken) .defs > div, :global(.tone-sunken) .coef > div, :global(.tone-sunken) .cards > div, :global(.tone-sunken) .results > div { background: var(--c-surface); }
  /* Separate bordered cards with real gaps. */
  .cmp, .screen { display: grid; gap: var(--space-6); margin-block: var(--space-4) var(--space-6); }
  .cmp > div, .screen > div { padding: var(--space-6); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); }
  .split { display: grid; gap: var(--space-8) var(--space-16); margin-block: var(--space-4) var(--space-6); }
  .ab, .coef b { font-size: var(--fs-h3); font-weight: 500; line-height: var(--lh-h3); color: var(--c-text); }
  .full, .k { font-family: var(--font-mono); font-size: var(--fs-label); line-height: var(--lh-small); color: var(--c-text-3); }
  p { color: var(--c-text-2); }
  .cards h4, .results b { font-size: var(--fs-h4); font-weight: 500; line-height: var(--lh-h4); letter-spacing: normal; color: var(--c-text); }
  .cards-imb h4 { font-size: var(--fs-h3); line-height: var(--lh-h3); color: var(--c-accent); }
  .cards-plan > div:first-child { box-shadow: inset 0 var(--bw-2) 0 var(--color-ok); }
  .cards-plan > .draft { box-shadow: inset 0 var(--bw-2) 0 var(--color-warn); }
  .results .ok b { color: var(--color-ok); }
  .results .cd b { color: var(--color-warn); }
  .results .mi b { color: var(--color-danger); }
  .tag { display: inline-flex; align-items: center; gap: var(--space-2); justify-self: start; text-transform: none; letter-spacing: 0; white-space: nowrap; color: var(--c-text-2); }
  .tag::before { content: ''; width: var(--space-2); height: var(--space-2); border-radius: var(--radius-full); background: currentColor; }
  .tag-law { color: var(--c-accent); }
  .tag-impl { color: var(--c-text-2); }
  .tag-draft { color: var(--color-warn); }
  .tag-future { color: var(--c-text-3); }
  .tag-enf { color: var(--color-danger); }
  :global(.tone-inverse) .tag-draft, :global(.tone-inverse) .tag-enf { color: var(--c-text-2); }

  /* ITBX classification cards: white, coloured top rule */
  .itbx { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); margin-block: var(--space-6) var(--space-4); }
  .itbx li { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; padding: var(--space-4); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); border-top: var(--bw-3) solid var(--c-accent); }
  .itbx .i li, .itbx li.i { border-top-color: var(--color-ok); }
  .itbx li.t { border-top-color: var(--c-text-2); }
  .itbx li.b { border-top-color: var(--color-warn); }
  .itbx li.x { border-top-color: var(--color-danger); }
  .L { font-family: var(--font-mono); font-size: var(--fs-h2); font-weight: 300; line-height: var(--lh-metric); color: var(--c-accent); }
  .itbx .i .L { color: var(--color-ok); }
  .itbx .t .L { color: var(--c-text-2); }
  .itbx .b .L { color: var(--color-warn); }
  .itbx .x .L { color: var(--color-danger); }
  .itbx b { font-size: var(--fs-h4); font-weight: 500; color: var(--c-text); }

  /* Lists: ruled rows, square bullets, zero-padded numbers */
  .restr, .checks, .feas, .steps4, .facts, .tools { margin-block: var(--space-5) var(--space-6); border-top: var(--bw-1) solid var(--c-text); }
  .restr, .checks { display: grid; }
  .restr li, .checks li { display: flex; align-items: baseline; gap: var(--space-3); margin-right: var(--space-8); padding-block: var(--space-4); border-bottom: var(--bw-1) solid var(--c-border); color: var(--c-text); }
  .restr li::before, .checks li::before { content: ''; flex: none; width: var(--space-2); height: var(--space-2); background: var(--c-accent); }
  .checks { margin-bottom: var(--space-10); }
  .feas { max-width: calc(var(--container-prose) * 1.15); counter-reset: f; }
  .feas li { counter-increment: f; display: grid; grid-template-columns: var(--space-10) minmax(0, 1fr); padding-block: var(--space-4); border-bottom: var(--bw-1) solid var(--c-border); color: var(--c-text); }
  .feas li::before { content: counter(f, decimal-leading-zero); font-family: var(--font-mono); font-size: var(--fs-label); color: var(--c-text-3); padding-top: var(--space-1); }
  .steps4 { display: grid; gap: var(--space-6); border-top: 0; counter-reset: s; }
  .steps4 li { counter-increment: s; display: flex; flex-direction: column; gap: var(--space-3); padding-top: var(--space-5); border-top: var(--bw-1) solid var(--c-text); color: var(--c-text); }
  .steps4 li::before { content: counter(s, decimal-leading-zero); font-family: var(--font-mono); font-size: var(--fs-label); color: var(--c-text-3); }
  .facts li, .tools li { display: grid; gap: var(--space-1) var(--space-12); padding-block: var(--space-5); border-bottom: var(--bw-1) solid var(--c-border); }
  .facts b, .tools b { font-size: var(--fs-h4); font-weight: 500; line-height: var(--lh-h4); color: var(--c-text); }
  .facts span, .tools span { color: var(--c-text-2); }
  .base { margin-block: 0; }
  .base li { gap: var(--space-2); }
  .base b { font-size: var(--fs-h4); font-weight: 500; color: var(--c-text); }
  .base span { font-size: var(--fs-small); color: var(--c-text-2); }

  /* Tables: ruled, no box. Stacked on small screens, real tables from 768px */
  .tbl-wrap { overflow-x: auto; margin-top: var(--space-4); border-top: var(--bw-1) solid var(--c-text); }
  .t { width: 100%; border-collapse: collapse; }
  .t thead { display: none; }
  .t thead th { padding: var(--space-3) var(--space-4); border-bottom: var(--bw-1) solid var(--c-border); font-family: var(--font-mono); font-size: var(--fs-label); font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-text-3); text-align: left; }
  .t th, .t td { padding: var(--space-4); text-align: left; vertical-align: top; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--c-text-2); }
  .t th[scope='row'] { color: var(--c-text); font-weight: 500; }
  .t tbody tr { border-bottom: var(--bw-1) solid var(--c-border); }
  .t tr.hl th, .t tr.hl td { background: var(--c-surface); }
  .t .grp th { padding: var(--space-5) var(--space-4) var(--space-2); background: transparent; color: var(--c-accent); font-family: var(--font-mono); font-size: var(--fs-label); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  .stack tr, .stack th, .stack td { display: block; }
  .stack tbody tr { padding-block: var(--space-4); }
  .stack th, .stack td { padding: var(--space-1) 0; }
  .stack th[scope='row'] { padding-bottom: var(--space-3); font-size: var(--fs-h4); }
  .stack td::before { content: attr(data-label); display: block; margin: var(--space-2) 0 var(--space-1); font-family: var(--font-mono); font-size: var(--fs-label); letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-text-3); }
  .code-cell { font-family: var(--font-mono); }
  .t :global(small) { display: block; color: var(--c-text-3); }
  .pma th[scope='row'] { font-family: var(--font-mono); font-weight: 400; }
  .pma th, .pma td, .audit-t .t th, .audit-t .t td { display: table-cell; padding: var(--space-3) var(--space-4); }
  .pma thead, .audit-t thead { display: table-header-group; }
  .pma tr, .audit-t tr { display: table-row; }

  /* PBG / SLF comparison */
  .cmp-h { display: grid; gap: var(--space-1); padding-bottom: var(--space-4); margin-bottom: var(--space-2); border-bottom: var(--bw-1) solid var(--c-text); }
  .cmp-h b { font-size: var(--fs-h2); font-weight: 300; line-height: var(--lh-metric); color: var(--c-text); }
  .cmp-h span { font-family: var(--font-mono); font-size: var(--fs-label); color: var(--c-text-3); }
  .cmp dl { display: grid; grid-template-columns: var(--space-24) minmax(0, 1fr); margin: 0; }
  .cmp dt, .cmp dd { padding-block: var(--space-3); border-bottom: var(--bw-1) solid var(--c-border); }
  .cmp dt { font-family: var(--font-mono); font-size: var(--fs-label); text-transform: none; letter-spacing: 0; color: var(--c-text-3); }
  .cmp dd { margin: 0; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--c-text); }
  .cmp dl > :nth-last-child(-n + 2) { border-bottom: 0; }

  /* Legalization path: rows on desktop, swipeable cards on mobile (as legacy) */
  .path { display: grid; grid-auto-flow: column; grid-auto-columns: min(83%, calc(var(--container-prose) * 0.65)); gap: var(--space-3); overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; padding-bottom: var(--space-4); margin-block: var(--space-4) var(--space-3); }
  .path > li { display: grid; grid-template-columns: var(--space-10) minmax(0, 1fr); gap: var(--space-3); align-content: start; scroll-snap-align: start; padding: var(--space-5); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); min-width: 0; }
  .st { display: grid; justify-items: start; align-content: start; gap: var(--space-1); }
  .st small { font-family: var(--font-mono); font-size: var(--fs-label); letter-spacing: 0.08em; color: var(--c-text-3); }
  .st b { font-size: var(--fs-h2); font-weight: 300; line-height: var(--lh-metric); letter-spacing: -0.03em; color: var(--c-accent); }
  .path h4 { font-size: var(--fs-h4); font-weight: 500; color: var(--c-text); }
  .path div { display: grid; gap: var(--space-2); }
  .zone { font-family: var(--font-mono); color: var(--c-text-3); }

  /* Compliance chain: 01–06 with top rules */
  .chain { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4) var(--space-3); margin-block: var(--space-4) var(--space-6); }
  .chain li { position: relative; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-5) var(--space-5) 0 0; border-top: var(--bw-1) solid var(--c-border-strong); }
  .chain li::after { content: ''; position: absolute; top: calc(var(--bw-1) * -1); left: 0; width: var(--space-8); height: var(--bw-2); background: var(--c-accent); }
  .node { font-family: var(--font-mono); font-size: var(--fs-label); color: var(--c-text-3); }
  .node::before { content: '0'; }
  .chain h3 { font-size: var(--fs-h4); font-weight: 500; line-height: var(--lh-h4); text-transform: none; letter-spacing: normal; }
  .chain p { color: var(--c-text-2); }

  /* KBLI shift */
  .kbli-shift { display: grid; gap: var(--space-4); align-items: stretch; margin-bottom: var(--space-8); }
  .kbli-shift .code { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-5) var(--space-6); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); }
  .kbli-shift .code b { font-size: var(--fs-display); font-weight: 300; letter-spacing: -0.04em; line-height: var(--lh-metric); }
  .kbli-shift .code span { display: flex; flex-direction: column; gap: var(--space-1); font-family: var(--font-mono); font-size: var(--fs-label); color: var(--c-text-3); }
