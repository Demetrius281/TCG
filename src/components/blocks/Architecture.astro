---
// Input -> processing -> output diagram on one shared Diagram (home and /platform render this same block).
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Card from '../ui/Card.astro';
import Cluster from '../ui/Cluster.astro';
import Diagram from '../ui/Diagram.astro';
import Action from '../ui/Action.astro';
import Text from '../ui/Text.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'architecture'>, 'type'>;
const { title, head, columns, inputs, engine, outputs, foot, note, action, tone, id, nav } = Astro.props;
const headId = `${id ?? 'architecture'}-h`;
---
<Section id={id} nav={nav} tone={tone} labelledby={headId}>
  <SectionHead title={title} id={headId} />
  <Card as="figure">
    <Cluster gap={24}>
      <Text as="span" role="label" tone="subtle">{head[0]}</Text>
      <Text as="span" role="label" tone="accent">{head[1]}</Text>
    </Cluster>
    <Diagram mode="layers" columns={columns} inputs={inputs} core={engine} outputs={outputs} foot={foot} />
  </Card>
  {note && <Text role="small" tone="subtle">{note}</Text>}
  {action && <Cluster gap="buttons"><Action action={action} fallbackVariant={tone === 'inverse' ? 'inverse' : 'primary'} /></Cluster>}
</Section>
