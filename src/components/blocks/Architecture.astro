---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'architecture'>, 'type'>;
const { label, title, head, columns, inputs, engine, outputs, foot, note, tone, id, nav } = Astro.props;
---
<Section id={id} nav={nav} tone={tone} labelledby={`${id}-h`}>
  <SectionHead label={label} title={title} id={`${id}-h`} />
  <figure class="arch">
    <div class="head t-label"><span>{head[0]}</span><span class="cp">{head[1]}</span></div>
    <div class="body">
      <span class="t-label colh in">{columns[0]}</span>
      <span class="t-label colh pr">{columns[1]}</span>
      <span class="t-label colh out">{columns[2]}</span>
      {inputs.map((n, i) => <div class={`node i r${i + 1}`}>{n.title}<small class="t-caption">{n.text}</small></div>)}
      {inputs.map((_, i) => <span class={`link a r${i + 1}`}></span>)}
      <div class="engine">
        <span class="t-label en-s">{engine.kicker}</span>
        <span class="en-t">{engine.title}</span>
        <div class="mods">
          {engine.modules.map((m) => <div class="mod">{m.title}<small class="t-caption">{m.text}</small></div>)}
        </div>
      </div>
      {outputs.map((_, i) => <span class={`link b r${i + 1}`}></span>)}
      {outputs.map((n, i) => <div class={`node o r${i + 1}`}>{n.title}<small class="t-caption">{n.text}</small></div>)}
    </div>
    <div class="foot">
      {foot.map((f) => <div class="af"><b>{f.title}</b><span class="t-small">{f.text}</span></div>)}
    </div>
  </figure>
  <p class="t-small note">{note}</p>
</Section>

<style>
  .intro { display: grid; gap: var(--space-3); max-width: var(--container-prose); margin-bottom: var(--space-8); }
  .label { color: var(--c-accent); }
  .arch { margin: 0; min-width: 0; background: var(--c-surface); border: var(--bw-1) solid var(--c-border); }
  .head { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-4); border-bottom: var(--bw-1) solid var(--c-border); color: var(--c-text-3); }
  .cp { color: var(--c-accent); }
  .body { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3); padding: var(--space-5) var(--space-4); }
  .colh { color: var(--c-text-3); }
  /* Stacked on mobile: each layer label sits above its group. */
  .colh.in { order: 1; }
  .node.i { order: 2; }
  .colh.pr { order: 3; }
  .engine { order: 4; }
  .colh.out { order: 5; }
  .node.o { order: 6; }
  .node { display: grid; gap: var(--space-1); min-width: 0; padding: var(--space-3) var(--space-4); background: var(--c-bg); border: var(--bw-1) solid var(--c-border-strong); font-size: var(--fs-small); font-weight: 500; }
  .node small { font-weight: 400; color: var(--c-text-3); }
  .link { display: none; }
  .engine { display: grid; gap: var(--space-3); padding: var(--space-4); background: var(--c-surface); border: var(--bw-2) solid var(--c-accent); }
  .en-s { color: var(--c-accent); }
  .en-t { font-size: var(--fs-h4); font-weight: 600; }
  .mods { display: grid; gap: var(--space-2); }
  .mod { display: grid; gap: var(--space-1); padding: var(--space-3); background: var(--c-bg); border: var(--bw-1) solid var(--c-border); font-size: var(--fs-small); font-weight: 500; }
  .mod small { font-weight: 400; color: var(--c-text-3); }
  .foot { display: grid; border-top: var(--bw-1) solid var(--c-border); }
  .af { display: grid; gap: var(--space-1); padding: var(--space-4); border-top: var(--bw-1) solid var(--c-border); }
  .af:first-child { border-top: 0; }
  .af span { color: var(--c-text-2); }
  .note { margin-top: var(--space-5); max-width: var(--container-prose); color: var(--c-text-3); }

  /* Desktop: three columns with flow connectors; the dots animate only here. */
  @media (min-width: 768px) {
    .head { flex-direction: row; justify-content: space-between; padding-inline: var(--space-6); }
    .body { grid-template-columns: 1fr var(--space-10) 1.4fr var(--space-10) 1fr; grid-auto-flow: row; align-items: center; padding: var(--space-6); gap: var(--space-3) 0; }
    .colh, .node, .engine { order: 0; }
    .colh.in { grid-column: 1; grid-row: 1; }
    .colh.pr { grid-column: 3; grid-row: 1; }
    .colh.out { grid-column: 5; grid-row: 1; }
    .node.i { grid-column: 1; }
    .node.o { grid-column: 5; }
    .node.r1 { grid-row: 2; }
    .node.r2 { grid-row: 3; }
    .node.r3 { grid-row: 4; }
    .link { display: block; position: relative; height: var(--bw-1); background: var(--c-border-strong); }
    .link.a { grid-column: 2; }
    .link.b { grid-column: 4; }
    .link.r1 { grid-row: 2; }
    .link.r2 { grid-row: 3; }
    .link.r3 { grid-row: 4; }
    .engine { grid-column: 3; grid-row: 2 / span 3; align-self: stretch; }
    .foot { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .af { border-top: 0; border-left: var(--bw-1) solid var(--c-border); }
    .af:first-child { border-left: 0; }
    .link::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 0;
      width: var(--space-2);
      height: var(--space-2);
      margin-top: calc(var(--space-1) / -1);
      border-radius: var(--radius-full);
      background: var(--color-accent-inverse);
      opacity: 0;
      animation: flow 3.6s ease-in-out infinite;
    }
    .link.r2::after { animation-delay: 1.2s; }
    .link.r3::after { animation-delay: 2.4s; }
    .link.b::after { animation-delay: 0.6s; }
    .link.b.r2::after { animation-delay: 1.8s; }
    .link.b.r3::after { animation-delay: 3s; }
  }
  @keyframes flow {
    0% { left: 0; opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { left: calc(100% - var(--space-2)); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .link::after { animation: none; opacity: 0; }
  }
</style>
