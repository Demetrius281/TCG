---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Cluster from '../ui/Cluster.astro';
import Text from '../ui/Text.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'spotlight'>, 'type'>;
const { title, lead, panel, tone, id, nav } = Astro.props;
---
<Section id={id} nav={nav} tone={tone} labelledby={`${id}-h`} layout="split" center>
  <SectionHead slot="head" title={title} lead={lead} id={`${id}-h`} />
  <Card as="aside" accent>
    <Text as="span" role="label" tone="subtle">{panel.kicker}</Text>
    <Cluster align="baseline" gap={16}>
      <Text as="span" role="metric" tone="accent">{panel.time.value}</Text>
      <Text as="span" role="label" tone="accent">{panel.time.unit}</Text>
    </Cluster>
    <Text tone="muted">{panel.result}</Text>
    <Cluster justify="between" align="baseline" gap={8}>
      <Text as="span" role="small" tone="subtle">{panel.comparison.label}</Text>
      <Text as="span" role="control">{panel.comparison.value}</Text>
    </Cluster>
    <Text role="small" tone="subtle">{panel.note}</Text>
    <Button slot="actions" href={panel.cta.href}>{panel.cta.label} <Text as="span" role="control">{panel.cta.arrow}</Text></Button>
  </Card>
</Section>
