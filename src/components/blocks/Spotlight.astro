---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'spotlight'>, 'type'>;
const { label, title, lead, panel, tone, id, nav } = Astro.props;
---
<Section id={id} nav={nav} tone={tone} labelledby={`${id}-h`}>
  <div class="layout">
    <div class="copy">
      <p class="t-label label">{label}</p>
      <h2 id={`${id}-h`}>{title}</h2>
      <p class="t-lead lead">{lead}</p>
    </div>
    <div class="panel">
      <span class="t-label kicker">{panel.kicker}</span>
      <div class="time"><strong>{panel.time.value}</strong><span class="t-label">{panel.time.unit}</span></div>
      <p class="t-body result">{panel.result}</p>
      <div class="comparison"><span class="t-small">{panel.comparison.label}</span><strong>{panel.comparison.value}</strong></div>
      <Button href={panel.cta.href}>{panel.cta.label} <span>{panel.cta.arrow}</span></Button>
      <p class="t-caption note">{panel.note}</p>
    </div>
  </div>
</Section>

<style>
  .layout { display: grid; gap: var(--space-8); align-items: center; }
  .copy { display: grid; gap: var(--space-4); }
  .label { color: var(--c-accent); }
  .lead { color: var(--c-text-2); }
  .panel { display: grid; gap: var(--space-4); padding: var(--space-6); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); border-top: var(--bw-2) solid var(--c-accent); }
  .kicker { color: var(--c-text-3); }
  .time { display: flex; align-items: baseline; gap: var(--space-3); }
  .time strong { font-size: var(--fs-metric); font-weight: 300; letter-spacing: -0.04em; line-height: var(--lh-metric); color: var(--c-accent); }
  .time span { color: var(--c-text-3); }
  .result { color: var(--c-text); }
  .comparison { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-4); padding-block: var(--space-4); border-block: var(--bw-1) solid var(--c-border); color: var(--c-text-2); }
  .comparison strong { font-size: var(--fs-h3); font-weight: 400; color: var(--c-text); }
  .note { color: var(--c-text-3); }
  @media (min-width: 1024px) {
    .layout { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--space-16); }
  }
</style>
