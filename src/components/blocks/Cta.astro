---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Action from '../ui/Action.astro';
import ActionStack from '../ui/ActionStack.astro';
import Card from '../ui/Card.astro';
import Cluster from '../ui/Cluster.astro';
import Grid from '../ui/Grid.astro';
import List from '../ui/List.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'cta'>, 'type'>;
const { title, text, action, secondary, side, next_steps, tone = 'inverse', id, nav } = Astro.props;
const fallback = tone === 'inverse' ? 'inverse' : 'primary';
---
<Section id={id} nav={nav} tone={tone} labelledby="cta-title">
  <Cluster gap={32} justify="between" align="center">
    <SectionHead title={title} lead={text} id="cta-title">
      {
        next_steps && (
          <List numbered>
            {next_steps.map((s) => <li><Text as="span" role="small" tone="muted">{s}</Text></li>)}
          </List>
        )
      }
    </SectionHead>
    {secondary ? <ActionStack action={action} link={secondary} fallbackVariant={fallback} /> : <Action action={action} fallbackVariant={fallback} />}
  </Cluster>
  {
    side && (
      <Card as="aside">
        <Text as="h3" role="card-title">{side.title}</Text>
        <Stack as="ul" gap={16}>
          {side.items.map((i) => <li><Stack gap={8} as="div"><Text as="span" role="label" tone="subtle">{i.label}</Text><Text as="span" role="small" tone="muted">{i.text}</Text></Stack></li>)}
        </Stack>
        {side.note && <Text role="small" tone="subtle">{side.note}</Text>}
      </Card>
    )
  }
</Section>
