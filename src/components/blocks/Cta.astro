---
import Section from '../ui/Section.astro';
import Action from '../ui/Action.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'cta'>, 'type'>;
const { label, title, text, action, secondary, side, next_steps, tone = 'inverse', id, nav } = Astro.props;
---
<Section id={id} nav={nav} tone={tone} labelledby="cta-title">
  <div class="cta">
    <div class="copy">
      {label && <p class="t-label label">{label}</p>}
      <h2 id="cta-title">{title}</h2>
      <p class="t-lead text">{text}</p>
    </div>
    <div class="side">
      <Action action={action} fallbackVariant={tone === 'inverse' ? 'inverse' : 'primary'} />
      {secondary && <a class="t-small secondary" href={secondary.href}>{secondary.label}</a>}
      {
        next_steps && (
          <ol class="next">
            {next_steps.map((s) => <li class="t-small">{s}</li>)}
          </ol>
        )
      }
    </div>
    {
      side && (
        <div class="side-docs">
          <h3>{side.title}</h3>
          <ol class="docs">
            {side.items.map((i) => <li><span class="t-label">{i.label}</span><span class="t-small">{i.text}</span></li>)}
          </ol>
          {side.note && <p class="t-small">{side.note}</p>}
        </div>
      )
    }
  </div>
</Section>

<style>
  .cta { display: grid; gap: var(--space-8); }
  .copy { display: grid; gap: var(--space-4); max-width: var(--container-prose); }
  .label { color: var(--c-text-2); }
  .text { color: var(--c-text-2); }
  .side { display: grid; gap: var(--space-6); justify-items: start; align-content: start; }
  .next { display: grid; gap: var(--space-2); color: var(--c-text-2); }
  .secondary { display: inline-flex; align-items: center; min-height: calc(var(--space-10) + var(--space-1)); color: var(--c-accent); font-weight: 500; }
  /* The optional documents column stays hidden on small screens, as on the legacy page. */
  .side-docs { display: none; gap: var(--space-4); }
  .docs { display: grid; gap: var(--space-3); }
  .docs li { display: grid; gap: var(--space-1); padding-top: var(--space-3); border-top: var(--bw-1) solid var(--c-border); }
  .docs .t-label { color: var(--c-accent); }
  .side-docs > p { color: var(--c-text-2); }
  @media (min-width: 768px) {
    .side-docs { display: grid; }
  }

  @media (min-width: 1024px) {
    .cta { grid-template-columns: 2fr 1fr; align-items: center; gap: var(--space-16); }
  }
</style>
