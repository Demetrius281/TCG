---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Grid from '../ui/Grid.astro';
import Card from '../ui/Card.astro';
import Cluster from '../ui/Cluster.astro';
import Text from '../ui/Text.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'steps'>, 'type'>;
const { title, layout, items, tone, id } = Astro.props;
const headId = `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---
<Section id={id} tone={tone} labelledby={headId}>
  <SectionHead title={title} id={headId} />
  <Grid as="ol" cols={layout === 'row' ? 3 : 2}>
    {
      items.map((s, i) => (
        <Card item accent={Boolean(s.first)}>
          <Cluster justify="between" gap={8}>
            <Text role="label" tone="accent">{s.label ?? String(i + 1).padStart(2, '0')}</Text>
            {s.timing && layout === 'grid' && <Text role="label" tone={s.first ? 'accent' : 'subtle'}>{s.timing}</Text>}
          </Cluster>
          <Text as="h3" role="card-title">{s.title}</Text>
          <Text tone="muted">{s.text}</Text>
          {s.timing && layout !== 'grid' && <Text role="label" tone="subtle">{s.timing}</Text>}
        </Card>
      ))
    }
  </Grid>
</Section>
