---
import Section from '../ui/Section.astro';
import { isPlaceholder } from '../../lib/placeholder';
import SectionHead from '../ui/SectionHead.astro';
import Grid from '../ui/Grid.astro';
import Card from '../ui/Card.astro';
import List from '../ui/List.astro';
import Stats from '../ui/Stats.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'metrics'>, 'type'>;
const { title, items, reach, notes, letter, partners, partners_title, tone, id } = Astro.props;
const showLetter = letter && !isPlaceholder(letter.quote) && !isPlaceholder(letter.href) && !isPlaceholder(letter.org);
const shownPartners = (partners ?? []).filter((p) => !isPlaceholder(p.name) && !isPlaceholder(p.href) && !isPlaceholder(p.group));
const ext = (href: string) => (/^https?:/.test(href) ? { target: '_blank', rel: 'noopener' } : {});
const headId = title ? `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` : undefined;
---
<Section id={id} tone={tone} labelledby={headId}>
  <SectionHead title={title} id={headId} />
  <Stats items={items} />
  {
    reach && (
      <Stack gap={12}>
        <Text as="h3" role="card-title">{reach.title}</Text>
        <Text tone="muted">{reach.text}</Text>
      </Stack>
    )
  }
  {
    (showLetter || shownPartners.length > 0) && (
      <Grid cols={2} class="proof">
        {showLetter && (
          <Card item>
            <Text as="h3" role="card-title">{letter!.title}</Text>
            <Text as="blockquote">{letter!.quote}</Text>
            <Text role="small"><a href={letter!.href} {...ext(letter!.href)}>{letter!.org}</a></Text>
          </Card>
        )}
        {shownPartners.length > 0 && (
          <Card item>
            {partners_title && <Text as="h3" role="card-title">{partners_title}</Text>}
            <List>
              {shownPartners.map((p) => <li><Text as="span" role="small" tone="subtle">{p.group}</Text> <a href={p.href} {...ext(p.href)}>{p.name}</a></li>)}
            </List>
          </Card>
        )}
      </Grid>
    )
  }
  {
    notes && (
      <Stack as="ul" gap={12}>
        {notes.map((n) => <li><Text as="span" tone="muted">{n}</Text></li>)}
      </Stack>
    )
  }
</Section>
