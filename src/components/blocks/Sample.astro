---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Card from '../ui/Card.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'sample'>, 'type'>;
const { title, lead, document_title, rows, note, tone, id } = Astro.props;
const headId = `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const statusText = { ok: 'Clear', warn: 'Attention', danger: 'Issue' } as const;
---
<Section id={id} tone={tone} labelledby={headId}>
  <SectionHead title={title} lead={lead} id={headId} />
  <Card as="figure">
    <Text as="figcaption" role="label" tone="subtle">{document_title}</Text>
    <Stack as="ul" gap={16}>
      {
        rows.map((r) => (
          <li>
            <Stack gap={8} as="div">
              <Text as="span" role="small" tone="subtle">{r.label}</Text>
              <Text as="span" tone={r.status}><span class="sr-only">{statusText[r.status]}: </span>{r.value}</Text>
            </Stack>
          </li>
        ))
      }
    </Stack>
    {note && <Text role="small" tone="subtle">{note}</Text>}
  </Card>
</Section>
