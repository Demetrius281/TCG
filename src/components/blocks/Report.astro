---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Stack from '../ui/Stack.astro';
import Cluster from '../ui/Cluster.astro';
import Table from '../ui/Table.astro';
import Text from '../ui/Text.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'report'>, 'type'>;
const { title, lead, line, document: doc, tone, id } = Astro.props;
const rows = doc.rows.map((r) => ({ cells: [r.category, r.finding, r.source, r.status_label] }));
---
<Section id={id} tone={tone} labelledby="report-title" layout="split">
  <SectionHead slot="head" title={title} lead={lead} id="report-title" />
  <Stack gap={24}>
    <Text role="small" tone="subtle">{line}</Text>
    <Card as="figure" aria-label={doc.aria_label}>
      <Cluster justify="between" gap={8} align="baseline">
        <Text as="span" role="label" tone="accent">{doc.brand}</Text>
        <Text as="span" role="small" tone="subtle">{doc.meta}</Text>
      </Cluster>
      <Text as="h3" role="card-title">{doc.title}</Text>
      <Table columns={doc.columns} groups={[{ rows }]} label={doc.findings_label} />
      <Grid as="div" cols={2}>
        <Card as="div">
          <Text as="span" role="label" tone="warn">{doc.risk.label}</Text>
          <Text role="small">{doc.risk.text}</Text>
        </Card>
        <Card as="div">
          <Text as="span" role="label" tone="ok">{doc.action.label}</Text>
          <Text role="small">{doc.action.text}</Text>
        </Card>
      </Grid>
      <Text role="small" tone="muted">{doc.includes}</Text>
      <Text role="small" tone="subtle">{doc.disclaimer}</Text>
    </Card>
  </Stack>
</Section>
