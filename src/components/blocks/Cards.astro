---
import Section from '../ui/Section.astro';
import Grid from '../ui/Grid.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'cards'>, 'type'>;
const { title, lead, meta, columns, items, note, link, fineprint, tone, id } = Astro.props;
const headId = title ? `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` : undefined;
---
<Section id={id} tone={tone} labelledby={headId}>
  <SectionHead title={title} lead={lead} meta={meta} id={headId} />
  <Grid cols={columns}>
    {
      items.map((item) => {
        const Tag = item.href ? 'a' : 'div';
        return (
          <li>
            <Tag class="card" href={item.href}>
              {item.label && <p class="t-label label">{item.label}</p>}
              <h3>{item.title}</h3>
              <p class="t-text text">{item.text}</p>
              {item.tag && <p class="t-label tag">{item.tag}</p>}
              {item.href && <span class="arrow" aria-hidden="true">→</span>}
            </Tag>
          </li>
        );
      })
    }
  </Grid>
  {link && <div class="link"><Button href={link.href} variant="secondary">{link.label}</Button></div>}
  {fineprint && <p class="t-small fineprint"><a href={fineprint.href}>{fineprint.label}</a></p>}
  {
    note && (
      <div class="note">
        <p class="t-text note-text">{note.text}</p>
        {note.link && <a class="t-small note-link" href={note.link.href}>{note.link.label}</a>}
      </div>
    )
  }
</Section>

<style>
  .link { margin-top: var(--space-8); }
  .fineprint { max-width: var(--container-prose); margin-top: var(--space-6); }
  .fineprint a { color: var(--c-text-2); text-decoration: underline; text-underline-offset: var(--space-1); }
  .card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    height: 100%;
    padding: var(--space-6);
    background: var(--c-surface);
    border: var(--bw-1) solid var(--c-border);
    border-radius: var(--radius);
    color: var(--c-text);
    text-decoration: none;
    transition: border-color var(--ease), transform var(--ease), box-shadow var(--ease);
  }
  a.card:hover {
    border-color: var(--c-accent);
    transform: translateY(calc(var(--space-1) / -2));
    box-shadow: var(--shadow-lift);
  }
  .label { color: var(--c-accent); }
  .text { color: var(--c-text-2); }
  .tag { margin-top: auto; padding-top: var(--space-3); border-top: var(--bw-1) solid var(--c-border); color: var(--c-accent); }
  .note { display: grid; gap: var(--space-3); justify-items: start; margin-top: var(--space-10); max-width: var(--container-prose); }
  .note-text { font-weight: 500; }
  .note-link { font-weight: 500; }
  .arrow { color: var(--c-accent); font-size: var(--fs-text); }

</style>
