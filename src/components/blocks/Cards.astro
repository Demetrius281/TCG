---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Grid from '../ui/Grid.astro';
import Card from '../ui/Card.astro';
import Text from '../ui/Text.astro';
import Stack from '../ui/Stack.astro';
import Cluster from '../ui/Cluster.astro';
import Button from '../ui/Button.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'cards'>, 'type'>;
const { title, lead, meta, columns, items, note, link, fineprint, tone, id } = Astro.props;
const headId = title ? `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` : undefined;
---
<Section id={id} tone={tone} labelledby={headId}>
  <SectionHead title={title} lead={lead} meta={meta} id={headId} />
  <Grid cols={columns}>
    {
      items.map((item) => (
        <Card item href={item.href}>
          {item.label && <Text role="label" tone="accent">{item.label}</Text>}
          <Text as="h3" role="card-title">{item.title}</Text>
          <Text tone="muted">{item.text}</Text>
          {item.href && <Text as="span" role="control" tone="accent" aria-hidden="true">→</Text>}
          {item.tag && <Text slot="foot" role="label" tone="accent">{item.tag}</Text>}
        </Card>
      ))
    }
  </Grid>
  {fineprint && <Text role="small" tone="muted"><a href={fineprint.href}>{fineprint.label}</a></Text>}
  {link && <Cluster gap="buttons"><Button href={link.href} variant="secondary">{link.label}</Button></Cluster>}
  {
    note && (
      <Stack gap={12} align="start">
        <Text>{note.text}</Text>
        {note.link && <a href={note.link.href}>{note.link.label}</a>}
      </Stack>
    )
  }
</Section>
