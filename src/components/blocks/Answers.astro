---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import List from '../ui/List.astro';
import Button from '../ui/Button.astro';
import { isPlaceholder } from '../../lib/placeholder';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'answers'>, 'type'>;
const { title, lead, launch, list_title, items, links, tone, id } = Astro.props;
const headId = `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const leadText = launch && !isPlaceholder(launch) ? `${lead} ${launch}` : lead;
---
<Section id={id} tone={tone} labelledby={headId}>
  <div class="answers">
    <div class="copy">
      <SectionHead title={title} lead={leadText} id={headId} next="actions" />
      {
        links && (
          <ul class="links">
            {links.map((l, i) => <li><Button href={l.href} variant={i === 0 ? 'secondary' : 'text'}>{l.label}</Button></li>)}
          </ul>
        )
      }
    </div>
    <div class="panel">
      <h3 class="panel-title">{list_title}</h3>
      <List numbered>
        {items.map((q) => <li class="t-text">{q}</li>)}
      </List>
    </div>
  </div>
</Section>

<style>
  .answers { display: grid; gap: var(--space-10); }
  .copy { display: grid; gap: 0; align-content: start; max-width: var(--container-prose); }
  .lead { color: var(--c-text-2); }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-6); margin: 0; }
  .panel { display: grid; gap: var(--space-3); align-content: start; padding: var(--space-6); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); border-top: var(--bw-2) solid var(--c-accent); }

  @media (min-width: 1024px) {
    .answers { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-16); align-items: start; }
  }
</style>
