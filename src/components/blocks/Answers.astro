---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import { isPlaceholder } from '../../lib/placeholder';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'answers'>, 'type'>;
const { title, lead, launch, list_title, items, links, tone, id } = Astro.props;
const headId = `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const leadText = launch && !isPlaceholder(launch) ? `${lead} ${launch}` : lead;
---
<Section id={id} tone={tone} labelledby={headId}>
  <div class="answers">
    <div class="copy">
      <h2 id={headId}>{title}</h2>
      <p class="t-lead lead">{leadText}</p>
      {
        links && (
          <ul class="links">
            {links.map((l, i) => <li><Button href={l.href} variant={i === 0 ? 'secondary' : 'text'}>{l.label}</Button></li>)}
          </ul>
        )
      }
    </div>
    <div class="panel">
      <h3 class="t-label panel-title">{list_title}</h3>
      <ul class="list">
        {items.map((q) => <li class="t-lead">{q}</li>)}
      </ul>
    </div>
  </div>
</Section>

<style>
  .answers { display: grid; gap: var(--space-10); }
  .copy { display: grid; gap: var(--space-4); align-content: start; max-width: var(--container-prose); }
  .lead { color: var(--c-text-2); }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-6); margin-top: var(--space-4); }
  .panel { display: grid; gap: var(--space-3); align-content: start; padding: var(--space-6); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); border-top: var(--bw-2) solid var(--c-accent); }
  .panel-title { color: var(--c-text-3); }
  .list { counter-reset: q; display: grid; }
  .list li { counter-increment: q; display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); padding-block: var(--space-4); border-top: var(--bw-1) solid var(--c-border); color: var(--c-text); }
  .list li::before { content: counter(q, decimal-leading-zero); font-family: var(--font-mono); font-size: var(--fs-label); line-height: var(--lh-lead); color: var(--c-accent); }

  @media (min-width: 1024px) {
    .answers { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-16); align-items: start; }
  }
</style>
