---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'pricing'>, 'type'>;
const { label, title, hint, note, result_label, tiers, tone, id } = Astro.props;
---
<Section id={id} tone={tone} labelledby="pricing-title">
  <SectionHead label={label} title={title} id="pricing-title" />
  {hint && <p class="t-caption hint">{hint}</p>}
  <div class="tiers" tabindex="0" aria-label="Pricing plans">
    {
      tiers.map((t) => (
        <article class:list={['tier', t.featured && 'top', t.standard && 'std']}>
          <div class="ttop">
            <h3 class="name">{t.name}</h3>
            {t.tag && <span class="t-label tag">{t.tag}</span>}
          </div>
          <div class="price">
            <span class="v">{t.price}</span>
            <span class="t-caption del">
              <span>{t.scope}</span>
              <span>{t.delivery}</span>
            </span>
          </div>
          <ul class="list">
            {t.features.map((f) => <li class:list={['t-small', f.inherited && 'inh']}>{f.text}</li>)}
          </ul>
          <div class="res">
            <span class="t-label rlab">{result_label}</span>
            <p class="t-small rtext">{t.result}</p>
          </div>
          <div class="tcta">
            <Button href={t.cta.href} variant={t.featured ? 'primary' : 'secondary'} data-plan={t.cta.plan}>{t.cta.label}</Button>
          </div>
        </article>
      ))
    }
  </div>
  {note && <p class="t-caption note">{note}</p>}
</Section>

<style>
  .hint { margin-bottom: var(--space-4); color: var(--c-text-3); }
  .tiers { display: grid; }
  .tiers:focus-visible { outline: var(--bw-2) solid var(--c-accent); outline-offset: var(--bw-3); }
  .tier {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
    padding: var(--space-6);
    background: var(--c-surface);
    border: var(--bw-1) solid var(--c-border);
    transition: border-color var(--ease), box-shadow var(--ease);
  }
  .tier:hover { border-color: var(--c-accent); box-shadow: var(--shadow-lift); }
  .top { order: -2; background: var(--c-surface); border-color: var(--c-accent); box-shadow: inset 0 0 0 var(--bw-1) var(--c-accent); }
  .std { order: -1; }
  .ttop { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-4); min-height: var(--space-6); }
  .name { font-size: var(--fs-h4); font-weight: 500; letter-spacing: -0.01em; color: var(--c-accent); }
  .tag { padding: var(--space-1) var(--space-3); border: var(--bw-1) solid var(--c-accent); color: var(--c-accent); }
  .price { display: grid; gap: var(--space-3); padding-bottom: var(--space-5); border-bottom: var(--bw-1) solid var(--c-text); }
  .v { font-size: var(--fs-h1); font-weight: 300; letter-spacing: -0.03em; line-height: var(--lh-metric); }
  .del { display: grid; gap: var(--space-1); font-family: var(--font-mono); color: var(--c-text-3); }
  .list { display: grid; }
  .list li { position: relative; padding: var(--space-3) 0 var(--space-3) var(--space-5); border-bottom: var(--bw-1) solid var(--c-border); }
  .list li:first-child { padding-top: 0; }
  .list li:last-child { padding-bottom: 0; border-bottom: 0; }
  .list li::before { content: ''; position: absolute; left: 0; top: calc(var(--space-3) + 0.72em); width: var(--space-3); height: var(--bw-1); background: var(--c-accent); }
  .list li:first-child::before { top: 0.72em; }
  .inh { color: var(--c-text-3); }
  .res { display: grid; gap: var(--space-2); padding-top: var(--space-5); border-top: var(--bw-1) solid var(--c-border); }
  .rlab { color: var(--c-text-3); }
  .rtext { color: var(--c-text); }
  .tcta { display: flex; flex-direction: column; margin-top: auto; }
  .note { margin-top: var(--space-6); max-width: calc(var(--container-prose) * 1.2); color: var(--c-text-3); }

  .hint { display: block; }
  .tiers {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: 86%;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    margin-inline: calc(var(--gutter) * -1);
    padding: var(--bw-2) var(--gutter) var(--space-4);
    scroll-padding-inline: var(--gutter);
  }
  .tier { scroll-snap-align: start; scroll-snap-stop: always; }

  @media (min-width: 768px) {
    .hint { display: none; }
    .tiers { grid-template-columns: 1fr; grid-auto-flow: row; grid-auto-columns: auto; overflow: visible; margin-inline: 0; padding: 0; gap: var(--space-5); scroll-snap-type: none; }
  }
  @media (min-width: 1024px) {
    .tiers { grid-template-columns: minmax(0, 1fr) minmax(0, 1.14fr) minmax(0, 1fr); padding-block: var(--space-4); }
    .tier { display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: var(--space-5); }
    .top, .std { order: 0; }
    .top { margin-block: calc(var(--space-4) * -1); padding-block: calc(var(--space-6) + var(--space-4)); }
    .tcta { margin-top: 0; align-self: end; }
  }
</style>
