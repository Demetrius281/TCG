---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Card from '../ui/Card.astro';
import Stack from '../ui/Stack.astro';
import Cluster from '../ui/Cluster.astro';
import Text from '../ui/Text.astro';
import Field from '../ui/Field.astro';
import Choices from '../ui/Choices.astro';
import Check from '../ui/Check.astro';
import FormButton from '../ui/FormButton.astro';
import Stage from '../ui/Stage.astro';
import StepBar from '../ui/StepBar.astro';
import DataRows from '../ui/DataRows.astro';
import Media from '../ui/Media.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'order'>, 'type'>;
const { title, lead, step_label, stages, summary_label, panel_aria, buttons, plan, property, documents, details, done, disclaimer, sticky_copy = true, tone = 'sunken', id } = Astro.props;
const stepText = (n: number) => step_label.replace('{n}', String(n)).replace('{total}', '4');
const stepHead = (n: number) => ({ label: stepText(n), title: stages[n - 1] });
---
<Section id={id} tone={tone} labelledby="order-title" layout="split" sticky={sticky_copy}>
  <Stack slot="head" gap={40}>
    <SectionHead title={title} lead={lead} id="order-title" />
    <div class="desk">
      <Stack gap={24}>
        <Stage decorative dataS items={stages.map((s, i) => ({ label: stepText(i + 1), text: s }))} />
        <Card as="div" aria-hidden="true">
          <Text as="span" role="label" tone="subtle">{summary_label}</Text>
          <Text as="span" role="control" id="os-plan"></Text>
          <Text as="span" role="small" tone="muted" id="os-del"></Text>
        </Card>
      </Stack>
    </div>
  </Stack>

  <Stack gap={24}>
    <Card as="div" id="pc-panel" aria-label={panel_aria}>
      <StepBar count={4} />
      <form id="pc-form" novalidate aria-labelledby="order-title">
        <Stack gap={32} class="pc-step" data-step="1">
          <Stack gap={8}>
            <Text role="label" tone="subtle" class="pc-stepno">{stepHead(1).label}</Text>
            <Text as="h3" role="card-title" tabindex="-1">{stepHead(1).title}</Text>
          </Stack>
          <Choices legend={plan.legend} hideLegend type="radio" name="plan" cols={1} options={plan.options.map((o) => ({ value: o.value, label: o.name, detail: o.detail, price: o.price, checked: o.checked }))} />
          <Cluster gap="buttons"><FormButton data-next="2">{buttons.next}</FormButton></Cluster>
        </Stack>

        <Stack gap={32} class="pc-step" data-step="2" hidden>
          <Stack gap={8}>
            <Text role="label" tone="subtle" class="pc-stepno">{stepHead(2).label}</Text>
            <Text as="h3" role="card-title" tabindex="-1">{stepHead(2).title}</Text>
          </Stack>
          <Stack gap={24}>
            <Choices id="pc-type-set" err="pc-type-err" legend={property.type.legend} type="radio" name="type" options={property.type.options.map((o) => ({ value: o.value, label: o.label }))} />
            <Stack gap={12}>
              <Field id="pc-loc" name="location" label={property.location.label} tag={property.location.tag} help={property.location.help} err inputmode="url" placeholder={property.location.placeholder} />
              <div id="pc-map-wrap" hidden>
                <Stack gap={12}>
                  <Media id="pc-map" aria-label={property.location.map_label} />
                  <Text role="small" tone="subtle" id="pc-map-msg" aria-live="polite"></Text>
                  <Cluster id="pc-map-bar" hidden justify="between" gap={12}>
                    <Text as="span" role="label" tone="muted" id="pc-pin"></Text>
                    <FormButton kind="pin" id="pc-pin-ok" aria-describedby="pc-map-err">{buttons.confirm_location}</FormButton>
                  </Cluster>
                  <Text role="small" tone="danger" id="pc-map-err"></Text>
                </Stack>
              </div>
            </Stack>
            <Choices id="pc-use-set" err="pc-use-err" legend={property.use.legend} tag={property.use.tag} type="checkbox" name="use" options={property.use.options.map((o) => ({ value: o.value, label: o.label }))} />
            <Field id="pc-project" name="project" label={property.project.label} tag={property.project.tag} />
            <Stack gap={24} id="pc-company-fld">
              <Field id="pc-seller" name="seller" label={property.seller.label} tag={property.seller.tag} help={property.seller.help} err />
              <Choices id="pc-stype-set" err="pc-stype-err" legend={property.seller_type.legend} type="radio" name="seller_type" options={property.seller_type.options.map((o) => ({ value: o.value, label: o.label }))} />
              <Field id="pc-legal" name="legal_company" label={property.legal.label} tag={property.legal.tag} help={property.legal.help} data-wrap="pc-legal-fld" hidden />
            </Stack>
            <Field id="pc-nib" name="nib" label={property.nib.label} tag={property.nib.tag} inputmode="numeric" err />
          </Stack>
          <Cluster gap="buttons">
            <FormButton data-next="3">{buttons.next}</FormButton>
            <FormButton kind="back" data-back="1">{buttons.back}</FormButton>
          </Cluster>
        </Stack>

        <Stack gap={32} class="pc-step" data-step="3" hidden>
          <Stack gap={8}>
            <Text role="label" tone="subtle" class="pc-stepno">{stepHead(3).label}</Text>
            <Text as="h3" role="card-title" tabindex="-1">{stepHead(3).title}</Text>
          </Stack>
          <Text role="small" tone="muted">{documents.lead}</Text>
          <Choices legend={documents.legend} hideLegend type="checkbox" name="docs" cols={1} options={documents.options.map((o) => ({ value: o.value, label: o.label, detail: o.detail }))} />
          <Text role="small" tone="subtle">{documents.note}</Text>
          <Cluster gap="buttons">
            <FormButton data-next="4" id="pc-docs-next">{buttons.next}</FormButton>
            <FormButton kind="back" id="pc-skip-docs">{buttons.skip_docs}</FormButton>
            <FormButton kind="back" data-back="2">{buttons.back}</FormButton>
          </Cluster>
        </Stack>

        <Stack gap={32} class="pc-step" data-step="4" hidden>
          <Stack gap={8}>
            <Text role="label" tone="subtle" class="pc-stepno">{stepHead(4).label}</Text>
            <Text as="h3" role="card-title" tabindex="-1">{stepHead(4).title}</Text>
          </Stack>
          <Stack gap={24}>
            <Field id="pc-name" name="name" label={details.name.label} autocomplete="name" err />
            <Field id="pc-email" name="email" type="email" label={details.email.label} help={details.email.help} autocomplete="email" inputmode="email" err />
            <Stack gap={8}>
              <Text as="span" role="label" tone="subtle">{details.review.label}</Text>
              <DataRows rows={[
                { label: details.review.plan, id: 'pc-r-plan' },
                { label: details.review.price, id: 'pc-r-price' },
                { label: details.review.location, id: 'pc-r-loc' },
                { label: details.review.documents, id: 'pc-r-docs' },
              ]} />
            </Stack>
            <Check id="pc-terms" name="terms" err>{details.terms.before}<a href={details.terms.href} target="_blank" rel="noopener">{details.terms.link_text}</a>{details.terms.after}</Check>
          </Stack>
          <Cluster gap="buttons">
            <FormButton id="pc-pay">{buttons.submit}</FormButton>
            <FormButton kind="back" data-back="3">{buttons.back}</FormButton>
          </Cluster>
          <Text role="small" tone="subtle" id="pc-wa-help">{details.help}</Text>
          <div role="status" aria-live="polite"><Text as="span" role="small" id="pc-pay-status"></Text></div>
        </Stack>
      </form>

      <Stack gap={24} id="pc-done" hidden>
        <Text as="h3" role="card-title" tabindex="-1">{done.title}</Text>
        <DataRows rows={[
          { label: done.rows[0], id: 'pc-d-id' },
          { label: done.rows[1], id: 'pc-d-plan' },
          { label: done.rows[2], id: 'pc-d-time' },
          { label: done.rows[3], id: 'pc-d-docs' },
        ]} />
        <Text role="small" tone="muted">{done.note.before}<Text as="span" role="small" id="pc-d-email"></Text>{done.note.after}</Text>
        <Text role="small" tone="muted">{done.retry.before}<a id="pc-wa-link" href="https://wa.me/6281337973097" target="_blank" rel="noopener">{done.retry.link_text}</a>{done.retry.after}</Text>
      </Stack>
    </Card>
    <Text role="small" tone="subtle">{disclaimer}</Text>
  </Stack>
</Section>

<style>
  .desk { display: none; }
  @media (min-width: 1024px) {
    .desk { display: block; }
  }
</style>

<script>
  import 'leaflet/dist/leaflet.css';
  import '../../scripts/due-diligence-order.js';
</script>
