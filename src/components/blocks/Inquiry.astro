---
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';
import Field from '../ui/Field.astro';
import FormButton from '../ui/FormButton.astro';
import Stage from '../ui/Stage.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'inquiry'>, 'type'>;
const { title, lead, stage, panel, fields: f, interest_options, message_placeholder, submit, disclaimer, sticky_copy = true, tone = 'sunken', id, nav } = Astro.props;
---
<Section id={id} nav={nav} tone={tone} labelledby="ei-title" layout="split" sticky={sticky_copy}>
  <Stack slot="head" gap={40}>
    <SectionHead title={title} lead={lead} id="ei-title" />
    <Stage items={stage} />
  </Stack>
  <Card as="div">
    <Stack gap={8}>
      <Text as="h3" role="card-title" id="ei-form-title">{panel.title}</Text>
      <Text role="small" tone="muted" id="ei-form-note">{panel.note}</Text>
    </Stack>
    <Stack as="form" gap={32} id="ei-form" novalidate aria-labelledby="ei-form-title" aria-describedby="ei-form-note">
      <Stack gap={24}>
        <Grid as="div" cols={2}>
          <Field id="ei-name" name="name" label={f.name.label} tag={f.name.tag} autocomplete="name" required err />
          <Field id="ei-org" name="organisation" label={f.organisation.label} tag={f.organisation.tag} autocomplete="organization" />
          <Field id="ei-role" name="role" label={f.role.label} tag={f.role.tag} autocomplete="organization-title" />
          <Field id="ei-interest" name="interest" kind="select" label={f.interest.label} tag={f.interest.tag} required err options={interest_options.map((o, i) => (i === 0 ? { value: o.value, label: o.label } : { label: o.label }))} />
        </Grid>
        <Field id="ei-contact" name="contact" label={f.contact.label} tag={f.contact.tag} required err />
        <Field id="ei-msg" name="message" kind="textarea" label={f.message.label} tag={f.message.tag} placeholder={message_placeholder} />
      </Stack>
      <Stack gap={12}>
        <FormButton type="submit">{submit}</FormButton>
        <div role="status" aria-live="polite"><Text as="span" role="small" id="ei-status"></Text></div>
      </Stack>
    </Stack>
    <Text role="small" tone="subtle">{disclaimer}</Text>
  </Card>
</Section>

<script>
  import '../../scripts/investment-inquiry.js';
</script>
