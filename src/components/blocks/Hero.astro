---
import Section from '../ui/Section.astro';
import Action from '../ui/Action.astro';
import PropertyCheckIllustration from '../illustrations/PropertyCheckIllustration.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'hero'>, 'type'>;
const { variant, label, title, lead, actions, meta, fee_note, illustration, metrics, tone, id } = Astro.props;
const display = variant === 'display';
---
<Section id={id} tone={tone} labelledby="hero-title">
  <div class:list={['hero', illustration && 'has-art']}>
    <div class="copy">
      {label && <p class="t-label label">{label}</p>}
      <h1 id="hero-title" class:list={[display && 't-display', 'title']}>{title}</h1>
      {lead && <p class="t-lead lead">{lead}</p>}
      {meta && <p class="t-label meta">{meta}</p>}
      {
        actions.length > 0 && (
          <div class="actions">
            {actions.map((a, i) => (
              <Action action={a} fallbackVariant={i === 0 ? 'primary' : 'secondary'} />
            ))}
          </div>
        )
      }
      {fee_note && <p class="t-small note">{fee_note}</p>}
    </div>
    {illustration === 'property-check' && <div class="art"><PropertyCheckIllustration /></div>}
    {
      metrics && (
        <dl class="metrics">
          {metrics.map((m) => (
            <div>
              <dt class="t-label">{m.label}</dt>
              <dd class="t-h3">{m.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</Section>

<style>
  .hero { display: grid; gap: var(--space-10); }
  .copy { display: grid; gap: var(--space-6); max-width: calc(var(--container-prose) * 1.3); justify-items: start; }
  .label { color: var(--c-accent); }
  .lead { color: var(--c-text-2); max-width: var(--container-prose); }
  .actions { display: grid; gap: var(--space-3); width: 100%; }
  .note { color: var(--c-text-3); }
  .meta { width: 100%; padding-block: var(--space-4); border-top: var(--bw-1) solid var(--c-text); border-bottom: var(--bw-1) solid var(--c-border); color: var(--c-text-3); }
  .art { display: none; min-width: 0; }
  .metrics { display: grid; gap: var(--space-6); }
  .metrics dt { color: var(--c-text-3); }

  @media (min-width: 768px) {
    .art { display: block; }
    .actions { display: flex; flex-wrap: wrap; width: auto; gap: var(--space-4); }
    .metrics { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1024px) {
    .has-art { grid-template-columns: 1.2fr 1fr; align-items: center; gap: var(--space-16); }
  }
</style>
