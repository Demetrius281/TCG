---
// The first screen of every page (CLAUDE.md rule 2): page-title, one paragraph, 1-2 buttons, optional illustration.
// Nothing else is rendered here. Meta strips, metric lists and extra links go to the next block.
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Action from '../ui/Action.astro';
import DesktopIllustration from '../ui/DesktopIllustration.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'hero'>, 'type'>;
const { heading_id = 'hero-title', title, subtitle, lead, actions, illustration, tone, id } = Astro.props;
---
<Section id={id} tone={tone} labelledby={heading_id}>
  <div class:list={['hero', illustration && 'has-art']} data-art={illustration}>
    <div class="copy">
      <SectionHead level={1} hero title={title} subtitle={subtitle} lead={lead} id={heading_id} next="actions" />
      {
        actions.length > 0 && (
          <div class="actions">
            {actions.slice(0, 2).map((a, i) => (
              <Action action={{ ...a, variant: i === 0 ? a.variant ?? 'primary' : 'secondary' }} fallbackVariant="primary" />
            ))}
          </div>
        )
      }
    </div>
    {
      illustration && (
        <div class="art">
          <DesktopIllustration name={illustration} />
        </div>
      )
    }
  </div>
</Section>

<style>
  .hero { display: grid; gap: var(--space-10); }
  .copy { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; max-width: var(--hero-title-max); }
  .actions { display: grid; gap: var(--space-3); width: 100%; }
  .art { display: none; min-width: 0; }

  @media (min-width: 768px) {
    .art { display: block; }
    .actions { display: flex; flex-wrap: wrap; width: auto; gap: var(--space-4); }
  }
  /* With an illustration: text left, illustration right, 50/50, gap 64, both top-aligned. */
  @media (min-width: 1024px) {
    .has-art { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: var(--space-16); }
  }
</style>
