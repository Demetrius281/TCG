---
// The first screen of every page (CLAUDE.md rule 2): page-title, one paragraph, 1-2 buttons, optional illustration.
// Nothing else is rendered here. Meta strips, metric lists and extra links go to the next block.
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import List from '../ui/List.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';
import Cluster from '../ui/Cluster.astro';
import Action from '../ui/Action.astro';
import DesktopIllustration from '../ui/DesktopIllustration.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'hero'>, 'type'>;
const { heading_id = 'hero-title', title, lead, actions, illustration, points, tone, id } = Astro.props;
---
<Section id={id} tone={tone} labelledby={heading_id} layout="hero" art={illustration}>
  <SectionHead level={1} hero title={title} lead={lead} id={heading_id}>
    {
      points && (
        <List class="points">
          {points.map((x) => <li><Stack gap={8} as="div"><Text as="span">{x.title}</Text><Text as="span" role="small" tone="muted">{x.text}</Text></Stack></li>)}
        </List>
      )
    }
    {
      actions.length > 0 && (
        <Cluster slot="actions" gap="buttons">
          {actions.slice(0, 2).map((a, i) => (
            <Action action={{ ...a, variant: i === 0 ? a.variant ?? 'primary' : 'secondary' }} fallbackVariant="primary" />
          ))}
        </Cluster>
      )
    }
  </SectionHead>
  {illustration && <DesktopIllustration slot="art" name={illustration} />}
</Section>
