---
// "Start where you are": the screen head, the service rows as full-width bands (Rows bleed), then a closing block.
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Rows from '../ui/Rows.astro';
import Stack from '../ui/Stack.astro';
import Cluster from '../ui/Cluster.astro';
import Text from '../ui/Text.astro';
import Action from '../ui/Action.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'services'>, 'type'>;
const { title, lead, groups, explore, start, tone = 'inverse', id } = Astro.props;
const headId = title ? `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` : undefined;
const items = groups.flatMap((g) => g.items);
---
<Section id={id} tone={tone} labelledby={headId}>
  <SectionHead title={title} lead={lead} id={headId} />
  <Rows bleed items={items.map((item) => ({ href: item.href, title: item.title, text: item.text, meta: item.meta, go: explore }))} />
  <Cluster gap={32} justify="between">
    <Stack gap={16}>
      <Text as="h3" role="card-title">{start.title}</Text>
      <Text tone="muted">{start.text}</Text>
    </Stack>
    <Cluster gap="buttons"><Action action={start.action} fallbackVariant="inverse" /></Cluster>
  </Cluster>
</Section>
