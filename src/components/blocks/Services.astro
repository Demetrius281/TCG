---
// "Start where you are": one inverse screen of numbered service rows in two groups, then a closing block.
// Row: number (label) · name (card-title) · text · meta (small) · Explore link. The whole row is the link.
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Action from '../ui/Action.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'services'>, 'type'>;
const { title, lead, groups, explore, start, tone = 'inverse', id } = Astro.props;
const headId = title ? `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` : undefined;
let n = 0;
const rows = groups.map((g) => ({ ...g, items: g.items.map((item) => ({ ...item, num: String(++n).padStart(2, '0') })) }));
---
<Section id={id} tone={tone} labelledby={headId}>
  <SectionHead title={title} lead={lead} id={headId} />
  <div class="groups">
    {
      rows.map((g) => (
        <div class="group" id={g.id}>
          {g.name && <h3 class="t-card-title gname">{g.name}</h3>}
          <ul class="list">
            {
              g.items.map((item) => (
                <li>
                  <a class="row" href={item.href}>
                    <span class="t-label num" aria-hidden="true">{item.num}</span>
                    <span class="body">
                      <span class="t-card-title name">{item.title}</span>
                      <span class="t-text desc">{item.text}</span>
                      <span class="t-small meta">{item.meta}</span>
                    </span>
                    <span class="t-small go">{explore} <span class="arr" aria-hidden="true">→</span></span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      ))
    }
  </div>
  <div class="start">
    <div class="copy">
      <h3 class="t-card-title">{start.title}</h3>
      <p class="t-text">{start.text}</p>
    </div>
    <div class="act">
      <Action action={start.action} fallbackVariant="inverse" />
      <a class="t-small link" href={start.link.href}>{start.link.label}</a>
    </div>
  </div>
</Section>

<style>
  .groups { display: grid; gap: var(--space-10); }
  .group { display: grid; gap: var(--space-4); }
  .gname { color: var(--c-text); }
  .list { border-top: var(--bw-1) solid var(--c-border); }
  .list li { border-bottom: var(--bw-1) solid var(--c-border); }
  .list li:last-child { border-bottom: 0; }
  .row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: var(--space-10) minmax(0, 1fr);
    gap: var(--space-3) var(--space-4);
    align-items: start;
    padding-block: var(--space-6);
    color: var(--c-text);
    text-decoration: none;
  }
  .row::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--space-4) * -1);
    z-index: -1;
    transition: background-color var(--ease), box-shadow var(--ease);
  }
  .num { padding-top: var(--space-1); color: var(--c-text-2); transition: color var(--ease); }
  .body { display: grid; gap: var(--space-3); min-width: 0; }
  .name { color: var(--c-text); }
  .desc { max-width: var(--container-prose); color: var(--c-text-2); }
  .meta { color: var(--c-text-2); }
  .go { grid-column: 2; display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 500; color: var(--c-accent); }
  .arr { display: inline-block; transition: transform var(--ease); }
  .row:hover::before, .row:focus-visible::before { background: var(--c-surface); box-shadow: inset var(--bw-3) 0 0 var(--c-accent); }
  .row:hover .num, .row:focus-visible .num { color: var(--c-accent); }
  .row:hover .arr, .row:focus-visible .arr { transform: translateX(calc(var(--space-1) * 1.5)); }
  .row:focus-visible { outline: none; }
  .row:focus-visible::before { outline: var(--bw-2) solid var(--c-accent); outline-offset: calc(var(--bw-2) * -1); }

  .start { display: grid; gap: var(--space-6); margin-top: var(--space-10); padding-top: var(--space-10); border-top: var(--bw-1) solid var(--c-border); }
  .copy { display: grid; gap: var(--space-3); max-width: var(--container-prose); }
  .copy p { color: var(--c-text-2); }
  .act { display: grid; gap: var(--space-4); justify-items: start; }
  .act :global(.btn) { justify-self: stretch; }
  .link { display: inline-flex; align-items: center; min-height: var(--space-8); color: var(--c-accent); font-weight: 500; }

  @media (min-width: 1024px) {
    .row { grid-template-columns: calc(var(--space-16) + var(--space-2)) minmax(0, 1fr) auto; gap: var(--space-3) var(--space-10); align-items: center; }
    .num { align-self: start; }
    .go { grid-column: auto; white-space: nowrap; }
    .start { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-10); }
    .act { justify-items: start; }
    .act :global(.btn) { justify-self: start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .row:hover .arr, .row:focus-visible .arr { transform: none; }
  }
</style>
