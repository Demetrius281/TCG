---
// "Start where you are": one inverse screen of service rows in two groups, then a closing block.
// Row: name (card-title) · text · meta (small) · Explore link. The whole row is the link.
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import ActionStack from '../ui/ActionStack.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'services'>, 'type'>;
const { title, lead, groups, explore, start, tone = 'inverse', id } = Astro.props;
const headId = title ? `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` : undefined;
---
<Section id={id} tone={tone} labelledby={headId}>
  <SectionHead title={title} lead={lead} id={headId} />
  <div class="bleed screen-gap groups">
    {
      groups.map((g) => (
        <div class="group" id={g.id}>
          {g.name && <h3 class="t-card-title gname">{g.name}</h3>}
          <ul class="rows">
            {
              g.items.map((item) => (
                <li class="item">
                  <a class="row" href={item.href}>
                    <span class="body">
                      <span class="t-card-title name">{item.title}</span>
                      <span class="t-text desc">{item.text}</span>
                      <span class="t-small meta">{item.meta}</span>
                    </span>
                    <span class="t-small go">{explore} <span class="arr" aria-hidden="true">→</span></span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      ))
    }
  </div>
  <div class="start">
    <div class="copy">
      <h3 class="t-card-title">{start.title}</h3>
      <p class="t-text">{start.text}</p>
    </div>
    <ActionStack action={start.action} link={start.link} fallbackVariant="inverse" />
  </div>
</Section>

<style>
  /* Hairlines and the hover band run edge to edge of the viewport (approved variation); the screen clips the overflow. */
  :global(.section:has(.bleed)) { overflow-x: clip; }
  .group { display: grid; gap: var(--space-4); }
  .gname { color: var(--c-text); }
  .rows, .start { position: relative; }
  .rows::before, .item .row::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    height: var(--bw-1);
    background: var(--c-border);
  }
  .rows::before { top: 0; }
  /* Only the last row of the screen keeps a hairline below it; the last row of the first group has none. */
  .group:not(:last-child) .item:last-child .row::after { display: none; }
  .item .row::after { bottom: 0; }
  .row {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-3);
    align-items: start;
    padding-block: var(--space-6);
    color: var(--c-text);
    text-decoration: none;
  }
  /* The band fills the row exactly between its two hairlines. */
  .row::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    z-index: -1;
    transition: background-color var(--ease), box-shadow var(--ease);
  }
  .item .row::before { bottom: var(--bw-1); }
  .group:not(:last-child) .item:last-child .row::before { bottom: 0; }
  .item:first-child .row::before { top: var(--bw-1); }
  .body { display: grid; gap: var(--space-3); min-width: 0; }
  .name { color: var(--c-text); }
  .desc { max-width: var(--container-prose); color: var(--c-text-2); }
  .meta { color: var(--color-on-inverse-3); }
  .go { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 500; color: var(--c-accent); }
  .arr { display: inline-block; transition: transform var(--ease); }
  .row:hover::before, .row:focus-visible::before { background: var(--color-inverse-hover); box-shadow: inset var(--bw-3) 0 0 var(--c-accent); }
  .row:hover .arr, .row:focus-visible .arr { transform: translateX(calc(var(--space-1) * 1.5)); }
  .row:focus-visible { outline: none; }
  .row:focus-visible::before { outline: var(--bw-2) solid var(--c-accent); outline-offset: calc(var(--bw-2) * -1); }

  .start { display: grid; gap: var(--space-6); margin-top: var(--space-10); }
  .copy { display: grid; gap: var(--space-3); max-width: var(--container-prose); }
  .copy p { color: var(--c-text-2); }

  /* From 560px: text left, Explore on the right. Below: one column, Explore under the meta. */
  @media (min-width: 560px) {
    .row { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-3) var(--space-10); align-items: center; }
  }
  @media (min-width: 1024px) {
    .start { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-10); }
  }
  @media (prefers-reduced-motion: reduce) {
    .row:hover .arr, .row:focus-visible .arr { transform: none; }
  }
</style>
