---
// "Start where you are": one inverse screen of service rows in two groups, then a closing block.
import Section from '../ui/Section.astro';
import SectionHead from '../ui/SectionHead.astro';
import Rows from '../ui/Rows.astro';
import Stack from '../ui/Stack.astro';
import Cluster from '../ui/Cluster.astro';
import Text from '../ui/Text.astro';
import ActionStack from '../ui/ActionStack.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'services'>, 'type'>;
const { title, lead, groups, explore, start, tone = 'inverse', id } = Astro.props;
const headId = title ? `h-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` : undefined;
---
<Section id={id} tone={tone} labelledby={headId}>
  <SectionHead title={title} lead={lead} id={headId} />
  <Stack gap={40}>
    {
      groups.map((g) => (
        <Stack gap={16} id={g.id}>
          {g.name && <Text as="h3" role="card-title">{g.name}</Text>}
          <Rows bleed items={g.items.map((item) => ({ href: item.href, title: item.title, text: item.text, meta: item.meta, go: explore }))} />
        </Stack>
      ))
    }
  </Stack>
  <Cluster gap={32} justify="between">
    <Stack gap={12}>
      <Text as="h3" role="card-title">{start.title}</Text>
      <Text tone="muted">{start.text}</Text>
    </Stack>
    <ActionStack action={start.action} link={start.link} fallbackVariant="inverse" />
  </Cluster>
</Section>
