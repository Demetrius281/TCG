---
import SectionNav from '../ui/SectionNav.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'guide_nav'>, 'type'>;
const { brand, title, links, jump, to_top } = Astro.props;
---
<SectionNav brand={brand} title={title} links={links} jump={jump} to_top={to_top} />
