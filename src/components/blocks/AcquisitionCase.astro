---
import Section from '../ui/Section.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'acquisition_case'>, 'type'>;
const { label, title, paragraphs, profit, case: c, tone, id, nav } = Astro.props;
---
<Section id={id} nav={nav} tone={tone} labelledby={`${id}-h`}>
  <div class="layout">
    <div class="copy">
      <p class="t-label label">{label}</p>
      <h2 id={`${id}-h`}>{title}</h2>
      {paragraphs.map((p, i) => <p class:list={['t-lead lead', i === 0 && 'intro']}>{p}</p>)}
      <div class="profit">
        <span class="picon">
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 24l8-8 6 5 10-12"></path><path d="M20 9h8v8"></path></svg>
        </span>
        <div><strong class="t-label">{profit.title}</strong><span class="t-body">{profit.text}</span></div>
      </div>
    </div>
    <article class="case">
      <div class="top t-label"><span>{c.top[0]}</span><span class="tag">{c.top[1]}</span></div>
      <div class="photo"><img src={c.photo.src} alt={c.photo.alt} width={c.photo.width} height={c.photo.height} loading="lazy" decoding="async" /></div>
      <div class="prices">
        {c.prices.map((p) => <div class:list={[p.discount && 'discount']}><span class="t-label plabel">{p.label}</span><strong>{p.value}</strong></div>)}
      </div>
      <div class="facts">
        {
          c.facts.map((f, i) => (
            <div>
              <span class="fname t-small">
                {i === 0 ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="3.2"></circle><path d="M5 20v-2c0-3.2 3-5 7-5s7 1.8 7 5v2"></path></svg>
                ) : (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-5 9 5-9 5-9-5zM3 14l9 5 9-5M3 18l9 5 9-5"></path></svg>
                )}
                {f.title}
              </span>
              <span class="t-small ftext">{f.text}</span>
            </div>
          ))
        }
      </div>
      <p class="t-caption disclaimer">{c.disclaimer}</p>
    </article>
  </div>
</Section>

<style>
  .layout { display: grid; gap: var(--space-8); align-items: start; }
  .copy { display: grid; gap: var(--space-4); }
  .label { color: var(--c-accent); }
  .lead { color: var(--c-text-2); }
  .intro { color: var(--c-text); font-weight: 500; }
  .profit { display: flex; gap: var(--space-4); align-items: flex-start; padding-top: var(--space-5); border-top: var(--bw-1) solid var(--c-border-strong); }
  .picon { display: flex; flex: none; width: var(--space-8); height: var(--space-8); color: var(--c-accent); }
  .picon svg { width: 100%; height: 100%; }
  .profit div { display: grid; gap: var(--space-1); }
  .profit span.t-body { color: var(--c-text-2); }
  .case { display: grid; gap: var(--space-4); min-width: 0; padding: var(--space-5); background: var(--c-surface); border: var(--bw-1) solid var(--c-border); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2); color: var(--c-text-3); }
  .tag { padding: var(--space-1) var(--space-3); border: var(--bw-1) solid var(--c-border-strong); }
  .photo { height: calc(var(--space-16) * 3.5); overflow: hidden; background: var(--c-bg); }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .prices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4) var(--space-3); }
  .prices > div { display: grid; gap: var(--space-2); }
  .plabel { color: var(--c-text-3); }
  .prices strong { font-size: var(--fs-h3); font-weight: 400; white-space: nowrap; }
  .prices .discount { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; padding: var(--space-3) var(--space-4); background: var(--c-bg); border-left: var(--bw-2) solid var(--c-accent); }
  .discount strong { font-size: var(--fs-h1); color: var(--c-accent); }
  .facts { display: grid; border-top: var(--bw-1) solid var(--c-border); }
  .facts > div { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-3) 0; border-bottom: var(--bw-1) solid var(--c-border); }
  .fname { display: inline-flex; align-items: center; gap: var(--space-3); font-weight: 500; }
  .fname svg { width: var(--space-5); height: var(--space-5); color: var(--c-accent); flex: none; }
  .ftext { padding-left: calc(var(--space-5) + var(--space-3)); color: var(--c-text-2); }
  .disclaimer { color: var(--c-text-3); }
  @media (min-width: 768px) {
    .prices { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .prices .discount { grid-column: auto; display: grid; padding: 0; background: none; border: 0; }
    .facts > div { flex-direction: row; align-items: center; justify-content: space-between; }
    .ftext { padding-left: 0; text-align: right; }
    .case { max-width: calc(var(--container-prose) * 1.6); }
  }
  @media (min-width: 1024px) {
    .layout { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: var(--space-16); }
  }
</style>
