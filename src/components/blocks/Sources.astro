---
import Section from '../ui/Section.astro';
import List from '../ui/List.astro';
import SectionHead from '../ui/SectionHead.astro';
import Rows from '../ui/Rows.astro';
import Card from '../ui/Card.astro';
import Cluster from '../ui/Cluster.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';
import type { BlockOf } from '../../content.config';

type Props = Omit<BlockOf<'sources'>, 'type'>;
const { title, intro, review, items, new_tab, notice, tone, id, nav } = Astro.props;
const kindTone = { law: 'accent', impl: 'muted', draft: 'subtle', future: 'subtle', enf: 'warn' } as const;
---
<Section id={id} nav={nav} tone={tone} labelledby="src-h">
  <SectionHead title={title} lead={intro.lead} id="src-h">
    <List>
      {intro.items.map((i) => <li><Text as="span" tone="muted">{i}</Text></li>)}
    </List>
  </SectionHead>
  <Card as="div">
    <Text role="small" tone="muted">{review.strong}<time>{review.date}</time>. {review.text}</Text>
    <Cluster gap={8}>
      {review.legend.map((t) => <Text as="span" role="label" tone={kindTone[t.kind as keyof typeof kindTone] ?? 'subtle'}>{t.label}</Text>)}
    </Cluster>
  </Card>
  <Rows items={items.map((s) => ({ href: s.href, external: true, label: s.authority, title: s.document, tag: s.tag.label }))} titleRole="text" newTab={new_tab} />
  {notice && <Text role="small" tone="muted">{notice.strong} {notice.text}</Text>}
</Section>
