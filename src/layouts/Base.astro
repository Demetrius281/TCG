---
import '../styles/tokens.css';
import '../styles/base.css';
import Head from '../components/seo/Head.astro';
import SkipLink from '../components/ui/SkipLink.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import { site } from '../data/site';
import type { Action } from '../content.config';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  ogTitle?: string;
  robots?: string;
  headerCta?: Action;
  mainClass?: string;
  ogType?: string;
  ogDescription?: string;
  extra?: { key: string; value: string; attr: 'name' | 'property' }[];
  jsonLd?: unknown;
}
const { headerCta, mainClass, ...props } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <Head {...props} />
  </head>
  <body>
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`}
        title="Google Tag Manager"
        width="0"
        height="0"
        hidden
      ></iframe>
    </noscript>
    <SkipLink />
    <Header cta={headerCta} />
    <main id="main" class={mainClass}><slot /></main>
    <Footer />
  </body>
</html>
