---
import Base from './Base.astro';
import Hero from '../components/blocks/Hero.astro';
import Cards from '../components/blocks/Cards.astro';
import Sample from '../components/blocks/Sample.astro';
import Services from '../components/blocks/Services.astro';
import Disclosure from '../components/blocks/Disclosure.astro';
import Metrics from '../components/blocks/Metrics.astro';
import Testimonials from '../components/blocks/Testimonials.astro';
import Logos from '../components/blocks/Logos.astro';
import Steps from '../components/blocks/Steps.astro';
import Faq from '../components/blocks/Faq.astro';
import Cta from '../components/blocks/Cta.astro';
import Report from '../components/blocks/Report.astro';
import Comparison from '../components/blocks/Comparison.astro';
import Pricing from '../components/blocks/Pricing.astro';
import Order from '../components/blocks/Order.astro';
import Features from '../components/blocks/Features.astro';
import Spotlight from '../components/blocks/Spotlight.astro';
import AcquisitionCase from '../components/blocks/AcquisitionCase.astro';
import Architecture from '../components/blocks/Architecture.astro';
import Inquiry from '../components/blocks/Inquiry.astro';
import GuideNav from '../components/blocks/GuideNav.astro';
import Topics from '../components/blocks/Topics.astro';
import Guide from '../components/blocks/Guide.astro';
import Sources from '../components/blocks/Sources.astro';
import type { Action, Block } from '../content.config';

interface Props {
  seo: {
    title: string;
    description: string;
    og_title?: string;
    robots?: string;
    og_image?: string;
    og_type?: string;
    og_description?: string;
    meta?: { key: string; value: string; attr: 'name' | 'property' }[];
    json_ld?: unknown;
  };
  blocks: Block[];
  headerCta?: Action;
  pageClass?: string;
}
const { seo, blocks, headerCta, pageClass } = Astro.props;

const registry = {
  hero: Hero,
  cards: Cards,
  sample: Sample,
  services: Services,
  disclosure: Disclosure,
  metrics: Metrics,
  testimonials: Testimonials,
  logos: Logos,
  steps: Steps,
  faq: Faq,
  cta: Cta,
  report: Report,
  comparison: Comparison,
  pricing: Pricing,
  order: Order,
  features: Features,
  spotlight: Spotlight,
  acquisition_case: AcquisitionCase,
  architecture: Architecture,
  inquiry: Inquiry,
  guide_nav: GuideNav,
  topics: Topics,
  guide: Guide,
  sources: Sources,
} as const;
---
<Base
  title={seo.title}
  description={seo.description}
  ogTitle={seo.og_title}
  robots={seo.robots}
  ogImage={seo.og_image}
  headerCta={headerCta}
  mainClass={pageClass}
  ogType={seo.og_type}
  ogDescription={seo.og_description}
  extra={seo.meta}
  jsonLd={seo.json_ld}
>
  {
    blocks.map(({ type, ...props }) => {
      const Component = registry[type] as any;
      return <Component {...props} />;
    })
  }
</Base>
