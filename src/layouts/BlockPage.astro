---
import Base from './Base.astro';
import Blocks from '../components/blocks/Blocks.astro';
import type { Action, Block } from '../content.config';

interface Props {
  seo: {
    title: string;
    description: string;
    og_title?: string;
    robots?: string;
    og_image?: string;
    og_type?: string;
    og_description?: string;
    meta?: { key: string; value: string; attr: 'name' | 'property' }[];
    json_ld?: unknown;
  };
  blocks: Block[];
  headerCta?: Action;
  pageClass?: string;
}
const { seo, blocks, headerCta, pageClass } = Astro.props;
---
<Base
  title={seo.title}
  description={seo.description}
  ogTitle={seo.og_title}
  robots={seo.robots}
  ogImage={seo.og_image}
  headerCta={headerCta}
  mainClass={pageClass}
  ogType={seo.og_type}
  ogDescription={seo.og_description}
  extra={seo.meta}
  jsonLd={seo.json_ld}
>
  <Blocks blocks={blocks} />
</Base>
