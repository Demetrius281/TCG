---
import Base from './Base.astro';
import Hero from '../components/blocks/Hero.astro';
import Cards from '../components/blocks/Cards.astro';
import Sample from '../components/blocks/Sample.astro';
import Services from '../components/blocks/Services.astro';
import Disclosure from '../components/blocks/Disclosure.astro';
import Metrics from '../components/blocks/Metrics.astro';
import Testimonials from '../components/blocks/Testimonials.astro';
import Logos from '../components/blocks/Logos.astro';
import Steps from '../components/blocks/Steps.astro';
import Faq from '../components/blocks/Faq.astro';
import Cta from '../components/blocks/Cta.astro';
import Report from '../components/blocks/Report.astro';
import Comparison from '../components/blocks/Comparison.astro';
import Pricing from '../components/blocks/Pricing.astro';
import Order from '../components/blocks/Order.astro';
import type { Block } from '../content.config';

interface Props {
  seo: { title: string; description: string; og_title?: string; robots?: string; og_image?: string };
  blocks: Block[];
  headerCta?: { label: string; href: string };
}
const { seo, blocks, headerCta } = Astro.props;

const registry = {
  hero: Hero,
  cards: Cards,
  sample: Sample,
  services: Services,
  disclosure: Disclosure,
  metrics: Metrics,
  testimonials: Testimonials,
  logos: Logos,
  steps: Steps,
  faq: Faq,
  cta: Cta,
  report: Report,
  comparison: Comparison,
  pricing: Pricing,
  order: Order,
} as const;
---
<Base
  title={seo.title}
  description={seo.description}
  ogTitle={seo.og_title}
  robots={seo.robots}
  ogImage={seo.og_image}
  headerCta={headerCta}
>
  {
    blocks.map(({ type, ...props }) => {
      const Component = registry[type] as any;
      return <Component {...props} />;
    })
  }
</Base>
