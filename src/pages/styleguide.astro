---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Blocks from '../components/blocks/Blocks.astro';
import Cards from '../components/blocks/Cards.astro';
import List from '../components/ui/List.astro';
import Section from '../components/ui/Section.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Button from '../components/ui/Button.astro';
import type { Block } from '../content.config';

// Every sample below is real TCG content, read from the content files at build time.
const home = await getEntry('home', 'index');
const pages = await getCollection('pages');
const guideEntry = await getEntry('pages', 'styleguide');
if (!home || !guideEntry) throw new Error('Missing content entries for /styleguide');
const all: Block[] = [...home.data.blocks, ...pages.flatMap((p) => p.data.blocks)];
const first = <T extends Block['type']>(type: T) => all.find((b) => b.type === type) as Extract<Block, { type: T }>;

const hero = first('hero');
const ddHero = (pages.find((p) => p.id === 'due-diligence')!.data.blocks[0]) as Extract<Block, { type: 'hero' }>;
const flow = first('flow');
const advisory = (home.data.blocks.find((b) => b.type === 'cards') ?? first('cards')) as Extract<Block, { type: 'cards' }>;
const capital = home.data.blocks.filter((b) => b.type === 'cards')[1] as Extract<Block, { type: 'cards' }>;
const metrics = first('metrics');
const answers = first('answers');
const cta = first('cta');
const faq = first('faq');
const cardPool = [...advisory.items, ...capital.items];
const grid = (n: 2 | 3 | 4): Extract<Block, { type: 'cards' }> => ({ type: 'cards', columns: n, items: cardPool.slice(0, n === 2 ? 2 : n) });

// First screen samples: one with and one without the illustration (same shared Hero).
const withArt: Block = { ...ddHero, id: undefined, heading_id: 'sg-hero-art' };
const withoutArt: Block = { ...ddHero, id: undefined, illustration: undefined, heading_id: 'sg-hero-page' };
const types = Array.from(new Set(all.map((b) => b.type)));
const singles: Block[] = types
  .filter((t) => t !== 'hero' && t !== 'guide' && t !== 'guide_nav')
  .map((t) => all.find((b) => b.type === t)!);
const guides = all.filter((b) => b.type === 'guide');
let prev = '';
const samples: Block[] = [...singles, ...guides].map((b) => {
  const out = { ...b } as Block;
  if (out.tone === 'inverse' && prev === 'inverse') out.tone = 'default';
  prev = out.tone ?? 'default';
  return out;
});
const blockIndex = ['hero', ...types.filter((t) => t !== 'hero')];

const roles = [
  { name: 'page-title 32/48', cls: 't-page-title', text: ddHero.title },
  { name: 'section-title 28/40', cls: 't-section-title', text: flow.title },
  { name: 'card-title 20/24', cls: 't-card-title', text: advisory.items[0].title },
  { name: 'text 16/17', cls: 't-text', text: advisory.items[0].text },
  { name: 'small 14/15', cls: 't-small', text: capital.items[0].text },
  { name: 'label 12 mono uppercase', cls: 't-label', text: flow.sources.title },
  { name: 'metric 48/72', cls: 't-metric', text: metrics.items[0].value },
];
const listItems = answers.items.slice(0, 3);
const navItems = answers.items.slice(0, 4);
---
<Base title="Styleguide | TCG" description="Design rules and every block of the TCG site, built from real page content." robots="noindex, nofollow">
  <Blocks blocks={[{ type: 'hero', title: 'Design rules', lead: flow.lead, actions: [{ label: 'Type roles', href: '#roles' }], heading_id: 'sg-title' } as Block]} />

  <Section id="roles" tone="sunken">
    <SectionHead title="Type roles" />
    <ul class="roles">
      {roles.map((r) => (
        <li class="role">
          <p class="t-label name">{r.name}</p>
          <p class={r.cls}>{r.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section>
    <SectionHead title="First screen with an illustration" />
  </Section>
  <Blocks blocks={[withArt]} />
  <Section tone="sunken">
    <SectionHead title="First screen without an illustration" />
  </Section>
  <Blocks blocks={[withoutArt]} />

  <Section>
    <SectionHead title="Lists on light" />
    <div class="lists">
      <List>{listItems.map((i) => <li class="t-text">{i}</li>)}</List>
      <List numbered>{listItems.map((i) => <li class="t-text">{i}</li>)}</List>
    </div>
  </Section>
  <Section tone="inverse">
    <SectionHead title="Lists on dark" />
    <div class="lists">
      <List>{listItems.map((i) => <li class="t-text">{i}</li>)}</List>
      <List numbered>{listItems.map((i) => <li class="t-text">{i}</li>)}</List>
    </div>
  </Section>

  <Section>
    <SectionHead title="Two screens in a row, same background" lead={answers.lead} />
  </Section>
  <Section>
    <SectionHead title={answers.title} lead={flow.lead} />
  </Section>

  <Section tone="sunken">
    <SectionHead title="Section tones" />
    <p class="t-text prose-p">default, sunken, inverse</p>
  </Section>
  <Section tone="inverse">
    <SectionHead title={cta.title} lead={cta.text} next="actions" />
    <div class="buttons"><Button href="/due-diligence" variant="inverse">inverse</Button></div>
  </Section>

  <Cards title="Layout: stacked" lead={flow.lead} columns={3} items={cardPool.slice(0, 3)} />
  <Section tone="sunken" layout="split">
    <SectionHead slot="head" title="Layout: split" lead={flow.lead} />
    <p class="t-text prose-p">{advisory.items[0].text}</p>
  </Section>
  <Section layout="article">
    <nav slot="nav" aria-label="Article">
      <List>{navItems.map((n) => <li class="t-small">{n}</li>)}</List>
    </nav>
    <div class="prose">
      <SectionHead title="Layout: article" lead={answers.lead} />
      <p class="t-text">{advisory.items[0].text}</p>
      <h3>{capital.items[0].title}</h3>
      <p class="t-text">{capital.items[0].text}</p>
    </div>
  </Section>

  <Cards {...grid(2)} title="Grid: 2 columns" tone="sunken" />
  <Cards {...grid(3)} title="Grid: 3 columns" />
  <Cards {...grid(4)} title="Grid: 4 columns" tone="sunken" />

  <Section>
    <SectionHead title="Buttons on light" next="actions" />
    <div class="buttons">
      <Button href="/due-diligence" variant="primary">{hero.actions[0].label}</Button>
      <Button href="/due-diligence" variant="secondary">{hero.actions[1].label}</Button>
    </div>
  </Section>
  <Section tone="inverse">
    <SectionHead title="Buttons on dark" next="actions" />
    <div class="buttons">
      <Button href="/due-diligence" variant="inverse">{hero.actions[0].label}</Button>
      <Button href="/due-diligence" variant="secondary">{hero.actions[1].label}</Button>
    </div>
  </Section>

  <Section tone="sunken">
    <SectionHead title="Blocks" lead="Every block type of the site, in this order below." />
    <List numbered>{blockIndex.map((n) => <li class="t-small">{n}</li>)}</List>
  </Section>
  <Blocks blocks={samples} />
</Base>

<style>
  .roles { display: grid; gap: var(--space-8); margin: 0; padding: 0; list-style: none; }
  .role { display: grid; gap: var(--space-2); }
  .role p { margin: 0; max-width: var(--hero-title-max); }
  .name { color: var(--color-text-3); }
  .buttons { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .lists { display: grid; gap: var(--space-8); max-width: var(--container-prose); }
  .prose { max-width: var(--container-prose); }
  .prose p:not(:last-child) { margin: 0 0 var(--space-4); }
  .prose :global(h3) { margin: var(--space-8) 0 var(--space-3); }
  .prose-p { max-width: var(--container-prose); margin: 0; }
  @media (min-width: 768px) {
    .buttons { gap: var(--space-4); }
  }
</style>
