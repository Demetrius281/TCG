---
import { getEntry } from 'astro:content';
import BlockPage from '../layouts/BlockPage.astro';

const page = await getEntry('pages', 'due-diligence');
if (!page) throw new Error('Missing content entry: pages/due-diligence');
---
<BlockPage seo={page.data.seo} blocks={page.data.blocks} headerCta={{ label: 'Check a Property', href: '#order' }} />
